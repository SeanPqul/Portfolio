---
import { Camera, RefreshCw, Disc, ShieldCheck, Focus } from "@lucide/astro";
---

<div class="glass grain rounded-3xl p-5 border border-white/8 relative overflow-hidden group/viewfinder select-none">
  <!-- Glowing subtle backdrop -->
  <div class="absolute -left-16 -top-16 size-36 bg-mint/5 rounded-full blur-2xl pointer-events-none"></div>
  
  <!-- Header Control Bar -->
  <div class="mb-4 flex items-center justify-between border-b border-white/8 pb-3">
    <div>
      <p class="text-[10px] font-bold tracking-widest text-mint uppercase flex items-center gap-1.5 animate-pulse">
        <Disc class="size-2 text-rose-500 fill-rose-500 animate-ping" />
        <span>System Live View</span>
      </p>
      <p class="text-lg font-bold font-display mt-0.5">DSLR Viewfinder</p>
    </div>
    
    <div class="flex items-center gap-2">
      <span class="text-[9px] font-mono font-bold bg-white/5 border border-white/10 text-muted px-2 py-0.5 rounded">
        AUTO-FOCUS: MULTI
      </span>
    </div>
  </div>

  <!-- Camera Screen Container -->
  <div class="relative w-full aspect-[4/5] sm:aspect-[3/4] rounded-2xl border border-white/10 bg-black overflow-hidden shadow-2xl">
    <!-- The actual graduation photo -->
    <img 
      id="dslr-image"
      src="/profile.jpg" 
      alt="Sean Paul graduation photoshoot" 
      class="w-full h-full object-cover object-[center_35%] transition-all duration-1000 cubic-bezier(0.16, 1, 0.3, 1)"
    />

    <!-- Exposure/Camera Shutter Flash Overlay -->
    <div id="shutter-flash" class="absolute inset-0 bg-white opacity-0 z-40 pointer-events-none transition-opacity duration-75"></div>

    <!-- Red "Saved" Image Toast overlay -->
    <div id="save-toast" class="absolute inset-0 bg-black/80 flex flex-col items-center justify-center gap-3 opacity-0 z-30 pointer-events-none transition-all duration-500 scale-95">
      <div class="size-16 rounded-full bg-mint/10 border border-mint/30 flex items-center justify-center text-mint">
        <ShieldCheck class="size-8" />
      </div>
      <p class="font-display font-extrabold text-sm tracking-wider text-ink">PORTRAIT CAPTURED</p>
      <p class="text-[10px] font-mono text-muted">sean_paul_portrait.raw saved to public/</p>
    </div>

    <!-- Rule of Thirds Gridlines (fades when focused) -->
    <div id="grid-lines" class="absolute inset-0 grid grid-cols-3 grid-rows-3 pointer-events-none z-10 opacity-20 transition-opacity duration-700">
      <div class="border-r border-b border-dashed border-white/40"></div>
      <div class="border-r border-b border-dashed border-white/40"></div>
      <div class="border-b border-dashed border-white/40"></div>
      <div class="border-r border-b border-dashed border-white/40"></div>
      <div class="border-r border-b border-dashed border-white/40"></div>
      <div class="border-b border-dashed border-white/40"></div>
      <div class="border-r border-dashed border-white/40"></div>
      <div class="border-r border-dashed border-white/40"></div>
      <div></div>
    </div>

    <!-- CAMERA Viewfinder UI elements (pointer-events-none) -->
    <div class="absolute inset-0 flex flex-col justify-between p-3.5 z-20 font-mono text-[9px] font-bold text-ink pointer-events-none tracking-wider">
      
      <!-- Viewfinder TOP Row -->
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-pulse"></span>
          <span>REC</span>
          <span id="recording-timer" class="text-rose-400 font-normal">00:04:12</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span>RAW</span>
          <span class="bg-white/10 px-1 py-0.2 rounded text-[8px]">4K 60FPS</span>
        </div>
      </div>

      <!-- Viewfinder CENTER Autofocus Brackets -->
      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 flex items-center justify-center pointer-events-none">
        <!-- AF Bracket Corners -->
        <div 
          id="af-box" 
          class="relative w-16 h-16 border-2 border-white/30 rounded-lg transition-all duration-500 ease-out scale-100 flex items-center justify-center"
        >
          <!-- Center spot dot -->
          <div id="af-dot" class="w-1.5 h-1.5 bg-white/40 rounded-full transition-colors duration-300"></div>

          <!-- Technical Corner accents -->
          <span class="absolute -top-1 -left-1 w-2.5 h-2.5 border-t-2 border-l-2 border-amber transition-colors duration-500" id="af-c1"></span>
          <span class="absolute -top-1 -right-1 w-2.5 h-2.5 border-t-2 border-r-2 border-amber transition-colors duration-500" id="af-c2"></span>
          <span class="absolute -bottom-1 -left-1 w-2.5 h-2.5 border-b-2 border-l-2 border-amber transition-colors duration-500" id="af-c3"></span>
          <span class="absolute -bottom-1 -right-1 w-2.5 h-2.5 border-b-2 border-r-2 border-amber transition-colors duration-500" id="af-c4"></span>
        </div>
        
        <!-- Focus Locked HUD label -->
        <div id="hud-focus-status" class="absolute top-10 text-[7px] bg-amber/10 border border-amber/20 text-amber px-1.5 py-0.2 rounded opacity-0 transition-opacity duration-300">
          AF-S LOCK
        </div>
      </div>

      <!-- Viewfinder BOTTOM Row -->
      <div class="flex flex-col gap-1 w-full">
        <!-- Light Meter Scale -->
        <div class="flex justify-center items-center gap-1.5 opacity-60 mb-1">
          <span>-2</span>
          <span class="text-[6px]">··</span>
          <span>-1</span>
          <span class="text-[6px]">··</span>
          <span class="text-amber">0</span>
          <span class="text-[6px]">··</span>
          <span>+1</span>
          <span class="text-[6px]">··</span>
          <span>+2</span>
        </div>
        
        <div class="flex items-center justify-between text-[8px] sm:text-[9px]">
          <div class="flex items-center gap-2">
            <span>SS: <span class="text-sky font-normal">1/125s</span></span>
            <span>AV: <span class="text-sky font-normal">F/2.8</span></span>
            <span>ISO: <span class="text-sky font-normal">400</span></span>
          </div>
          <div class="flex items-center gap-1.5">
            <span>BATT</span>
            <div class="w-6 h-3 border border-white/30 rounded-sm p-0.5 flex items-center gap-0.2">
              <div class="h-full w-4/5 bg-mint rounded-2xs"></div>
            </div>
            <span>88%</span>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- DSLR Viewfinder Camera Controls Panel -->
  <div class="mt-4 grid grid-cols-2 gap-3">
    <!-- AF-ON Focus Button -->
    <button 
      id="btn-focus"
      class="flex items-center justify-center gap-2 rounded-xl border border-white/8 bg-white/4 px-4 py-2.5 text-xs font-bold font-display text-ink hover:bg-white/8 hover:border-white/15 transition active:scale-97 cursor-pointer"
      title="Toggle camera focus and portrait view"
    >
      <Focus size={14} class="text-amber shrink-0" id="btn-focus-icon" />
      <span id="btn-focus-text">Focus Lens (AF-S)</span>
    </button>
    
    <!-- Shutter Click Button -->
    <button 
      id="btn-shutter"
      class="flex items-center justify-center gap-2 rounded-xl bg-mint px-4 py-2.5 text-xs font-extrabold font-display text-bg-deep hover:bg-[#7af0c8] hover:shadow-lg hover:shadow-mint/15 transition active:scale-97 cursor-pointer"
      title="Capture graduation portrait"
    >
      <Camera size={14} class="shrink-0" />
      <span>Trigger Shutter</span>
    </button>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const dslrImage = document.getElementById("dslr-image") as HTMLImageElement;
    const afBox = document.getElementById("af-box");
    const afDot = document.getElementById("af-dot");
    const afCornerElements = [
      document.getElementById("af-c1"),
      document.getElementById("af-c2"),
      document.getElementById("af-c3"),
      document.getElementById("af-c4")
    ];
    const gridLines = document.getElementById("grid-lines");
    const btnFocus = document.getElementById("btn-focus");
    const btnFocusText = document.getElementById("btn-focus-text");
    const btnShutter = document.getElementById("btn-shutter");
    const shutterFlash = document.getElementById("shutter-flash");
    const saveToast = document.getElementById("save-toast");
    const hudFocusStatus = document.getElementById("hud-focus-status");
    const timerDisplay = document.getElementById("recording-timer");

    let isFocused = false;
    let autoFocusTimer: NodeJS.Timeout | null = null;

    // A. Zoom & Translation Settings (specifically framing Sean Paul in the photo)
    const zoomInStyles = {
      transform: "scale(1.8) translate(14%, 8%)",
      filter: "blur(0px) contrast(1.05) saturate(1.02)"
    };
    
    const defaultStyles = {
      transform: "scale(1) translate(0, 0)",
      filter: "blur(2px) contrast(0.95)" // Default state is slightly blurry to represent out-of-focus
    };

    // Apply default blur on startup
    if (dslrImage) {
      dslrImage.style.transform = defaultStyles.transform;
      dslrImage.style.filter = defaultStyles.filter;
    }

    // B. Recording Timer Simulation
    let seconds = 252; // 00:04:12 starting time
    setInterval(() => {
      seconds++;
      const hrs = Math.floor(seconds / 3600).toString().padStart(2, "0");
      const mins = Math.floor((seconds % 3600) / 60).toString().padStart(2, "0");
      const secs = (seconds % 60).toString().padStart(2, "0");
      if (timerDisplay) {
        timerDisplay.textContent = `${hrs}:${mins}:${secs}`;
      }
    }, 1000);

    // C. Focus Toggle Function
    function toggleFocus(forceState?: boolean) {
      isFocused = forceState !== undefined ? forceState : !isFocused;

      if (isFocused) {
        // 1. Simulate active focusing sweep
        if (btnFocusText) btnFocusText.textContent = "Focusing...";
        if (afBox) {
          afBox.classList.remove("scale-100");
          afBox.classList.add("scale-115");
          afBox.style.borderColor = "rgba(246, 197, 111, 0.6)";
        }
        afCornerElements.forEach(el => {
          if (el) el.style.borderColor = "var(--color-amber)";
        });

        // Small delay to simulate AF motor speed
        autoFocusTimer = setTimeout(() => {
          // 2. Lock Focus State
          if (dslrImage) {
            dslrImage.style.transform = zoomInStyles.transform;
            dslrImage.style.filter = zoomInStyles.filter;
          }
          if (afBox) {
            afBox.classList.remove("scale-115");
            afBox.classList.add("scale-95");
            afBox.style.borderColor = "rgba(102, 224, 181, 0.4)";
          }
          if (afDot) {
            afDot.style.backgroundColor = "var(--color-mint)";
          }
          afCornerElements.forEach(el => {
            if (el) el.style.borderColor = "var(--color-mint)";
          });
          if (gridLines) gridLines.style.opacity = "0.03"; // fade gridlines out when focused
          if (hudFocusStatus) {
            hudFocusStatus.style.opacity = "1";
            hudFocusStatus.classList.remove("text-amber", "bg-amber/10", "border-amber/20");
            hudFocusStatus.classList.add("text-mint", "bg-mint/10", "border-mint/20");
            hudFocusStatus.textContent = "AF-S LOCKED";
          }
          if (btnFocusText) btnFocusText.textContent = "Reset Focus (MF)";
        }, 400);

      } else {
        // Reset to Default Out-Of-Focus State
        if (autoFocusTimer) clearTimeout(autoFocusTimer);
        
        if (dslrImage) {
          dslrImage.style.transform = defaultStyles.transform;
          dslrImage.style.filter = defaultStyles.filter;
        }
        if (afBox) {
          afBox.classList.remove("scale-95", "scale-115");
          afBox.classList.add("scale-100");
          afBox.style.borderColor = "rgba(255, 255, 255, 0.3)";
        }
        if (afDot) {
          afDot.style.backgroundColor = "rgba(255, 255, 255, 0.4)";
        }
        afCornerElements.forEach(el => {
          if (el) el.style.borderColor = "var(--color-amber)";
        });
        if (gridLines) gridLines.style.opacity = "0.2";
        if (hudFocusStatus) hudFocusStatus.style.opacity = "0";
        if (btnFocusText) btnFocusText.textContent = "Focus Lens (AF-S)";
      }
    }

    // D. Event Listeners for Focus
    if (btnFocus) {
      btnFocus.addEventListener("click", () => toggleFocus());
    }

    // Hover Viewport Auto-focus effect (standard developer interaction)
    const viewfinder = dslrImage?.parentElement;
    if (viewfinder) {
      viewfinder.addEventListener("mouseenter", () => {
        if (!isFocused) toggleFocus(true);
      });
      viewfinder.addEventListener("mouseleave", () => {
        // Reset focus on hover leave ONLY if toast is not showing
        if (saveToast && saveToast.style.opacity !== "1") {
          toggleFocus(false);
        }
      });
    }

    // E. Shutter Capture Mechanism
    if (btnShutter) {
      btnShutter.addEventListener("click", () => {
        // 1. Force focus lock first if not focused
        if (!isFocused) {
          toggleFocus(true);
        }

        // 2. Play shutter sound simulation (via flash)
        if (shutterFlash) {
          shutterFlash.style.opacity = "1";
          setTimeout(() => {
            shutterFlash.style.opacity = "0";
          }, 80);
        }

        // 3. Display the "Saved Raw Portrait" screen preview
        setTimeout(() => {
          if (saveToast) {
            saveToast.style.opacity = "1";
            saveToast.style.pointerEvents = "auto";
          }
          
          // Clear after 3.5 seconds
          setTimeout(() => {
            if (saveToast) {
              saveToast.style.opacity = "0";
              saveToast.style.pointerEvents = "none";
            }
          }, 3500);
        }, 150);
      });
    }

  });
</script>
