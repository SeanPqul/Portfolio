---
import { Maximize2, X, Sparkles, Clock, Calendar, Smartphone } from "@lucide/astro";
import fukurouCoverImage from "../../assets/projects/fukurou/fukurou_cover.png?url";
---

<!-- Fukurou Case Study Modal -->
<div
  id="fukurou-modal"
  class="project-modal fixed inset-0 z-[100] hidden items-center justify-center bg-black/80 p-2 sm:p-6 backdrop-blur-md"
  role="dialog"
  aria-modal="true"
  aria-labelledby="fukurou-modal-title"
>
  <div class="project-modal-panel max-h-[92vh] w-full max-w-5xl overflow-y-auto overflow-x-hidden rounded-2xl border border-slate-200/90 bg-white text-slate-950 shadow-2xl transition-all dark:border-white/10 dark:bg-[#0c1015] dark:text-ink">
    <!-- Modal Header -->
    <div class="project-modal-header sticky top-0 z-20 flex items-start justify-between gap-3 border-b border-slate-200/80 bg-white/95 px-4 py-3.5 backdrop-blur-md dark:border-white/8 dark:bg-[#0c1015]/95 sm:items-center sm:px-6 sm:py-4.5">
      <div class="min-w-0 flex-1 space-y-1">
        <div class="flex items-center gap-2">
          <h2 id="fukurou-modal-title" class="font-display text-xl sm:text-2xl font-bold tracking-tight text-ink">
            Fukurou
          </h2>
        </div>
        <p class="text-xs text-muted leading-relaxed">
          Automated Schedule Import &amp; Shift Management Platform
        </p>
      </div>
      <div class="flex shrink-0 items-center gap-2 pt-0.5 sm:pt-0">
        <button
          type="button"
          class="project-modal-close inline-flex size-8.5 items-center justify-center rounded-lg border border-transparent text-muted transition-colors hover:border-slate-200 hover:bg-slate-100 hover:text-ink dark:hover:border-white/10 dark:hover:bg-white/10 dark:hover:text-ink cursor-pointer"
          aria-label="Close Fukurou details"
        >
          <X size={18} />
        </button>
      </div>
    </div>

    <!-- Modal Body Grid (strictly bounded) -->
    <div class="grid min-w-0 gap-6 p-4 sm:p-6 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-8">
      <!-- Left Column: Scope & Overview (Typography-First) -->
      <div class="min-w-0 flex flex-col justify-between space-y-6">
        <div class="space-y-6">
          <!-- Technical Highlights -->
          <div class="space-y-3.5">
            <div class="flex items-center justify-between border-b border-slate-200/60 pb-2 dark:border-white/8 min-h-[29px]">
              <span class="font-mono text-[10px] font-bold uppercase tracking-widest text-mint">
                Technical Highlights
              </span>
            </div>
            <ul class="space-y-4">
              <li class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="size-1.5 shrink-0 rounded-full bg-mint"></span>
                  <h3 class="font-sans text-sm font-semibold text-ink">Multi-Source OCR &amp; Spreadsheet Pipeline</h3>
                </div>
                <p class="pl-3.5 text-xs sm:text-sm text-muted leading-relaxed">
                  Engineered an asynchronous schedule ingestion backend using FastAPI, PaddleOCR, and Pandas to parse rosters and timetables from images, PDFs, CSVs, and Excel sheets with per-field confidence scoring.
                </p>
              </li>

              <li class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="size-1.5 shrink-0 rounded-full bg-mint"></span>
                  <h3 class="font-sans text-sm font-semibold text-ink">Interactive Verification &amp; Conflict Audit</h3>
                </div>
                <p class="pl-3.5 text-xs sm:text-sm text-muted leading-relaxed">
                  Implemented strict human-in-the-loop review flows in React Native (Expo) allowing users to inspect flagged low-confidence entries, adjust shifts, and resolve overlapping timetable conflicts before commitment.
                </p>
              </li>

              <li class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="size-1.5 shrink-0 rounded-full bg-mint"></span>
                  <h3 class="font-sans text-sm font-semibold text-ink">Glanceable Dashboard &amp; Native Android Widget</h3>
                </div>
                <p class="pl-3.5 text-xs sm:text-sm text-muted leading-relaxed">
                  Built countdown shift cards, week/month calendar views, customizable notification alarms, and a native Android home-screen widget via <code class="rounded bg-mint/10 px-1 py-0.5 font-mono text-[11px] text-mint">react-native-android-widget</code>.
                </p>
              </li>
            </ul>
          </div>

          <!-- Subtle Divider -->
          <div class="border-t border-slate-200/70 dark:border-white/8"></div>

          <!-- Project Concept -->
          <div class="space-y-2">
            <span class="font-mono text-[10px] font-bold uppercase tracking-widest text-muted">
              About the System
            </span>
            <p class="text-xs sm:text-sm text-muted leading-relaxed">
              Fukurou transforms unstructured schedule documents—photos, screenshots, PDFs, CSVs, and Excel spreadsheets—into verified digital schedules with smart countdowns, conflict detection, and native Android home-screen widgets in under two minutes.
            </p>
          </div>
        </div>

        <!-- Tech Stack Footer -->
        <div class="flex flex-wrap items-center justify-between gap-2 border-t border-slate-200/70 pt-4 dark:border-white/8 text-xs text-muted">
          <div class="flex items-center gap-2">
            <span class="font-mono text-[10px] font-bold uppercase tracking-wider text-muted">Stack:</span>
            <span>React Native • Expo • FastAPI • Python • PaddleOCR • PostgreSQL • MMKV</span>
          </div>
        </div>
      </div>

      <!-- Right Column: System Interfaces Showcase (Strictly Contained) -->
      <div class="min-w-0 space-y-5">
        <!-- Top Unified Header Bar -->
        <div class="flex items-center justify-between border-b border-slate-200/60 pb-2 dark:border-white/8 min-h-[29px]">
          <span class="font-mono text-[10px] font-bold uppercase tracking-widest text-ink">
            Core Architecture &amp; Capabilities
          </span>
          <span class="rounded-full border border-mint/25 bg-mint/10 px-2.5 py-0.5 font-mono text-[9px] font-semibold uppercase tracking-wider text-mint shadow-xs backdrop-blur-sm">
            System Overview
          </span>
        </div>

        <!-- Feature Pillar Cards Grid -->
        <div class="grid min-w-0 gap-4 sm:grid-cols-2">
          <!-- Card 1: OCR Ingestion -->
          <div class="flex flex-col justify-between rounded-xl border border-slate-200/80 bg-slate-50/60 p-4 dark:border-white/10 dark:bg-white/[0.02]">
            <div class="space-y-2">
              <div class="flex items-center gap-2 text-mint">
                <Sparkles size={16} />
                <span class="font-sans text-xs font-bold text-ink">OCR Ingestion Engine</span>
              </div>
              <p class="text-[11.5px] leading-relaxed text-muted">
                PaddleOCR + Pandas ingestion pipeline extracts structured shift times, roles, and locations from photos and Excel sheets.
              </p>
            </div>
            <div class="mt-3 flex items-center gap-1.5 font-mono text-[10px] text-muted">
              <span class="size-1.5 rounded-full bg-mint"></span>
              <span>FastAPI • Python 3.13</span>
            </div>
          </div>

          <!-- Card 2: Native Android Widget -->
          <div class="flex flex-col justify-between rounded-xl border border-slate-200/80 bg-slate-50/60 p-4 dark:border-white/10 dark:bg-white/[0.02]">
            <div class="space-y-2">
              <div class="flex items-center gap-2 text-mint">
                <Smartphone size={16} />
                <span class="font-sans text-xs font-bold text-ink">Android Home Widget</span>
              </div>
              <p class="text-[11.5px] leading-relaxed text-muted">
                Glanceable native home-screen widget displaying upcoming commitments and live countdowns without opening the app.
              </p>
            </div>
            <div class="mt-3 flex items-center gap-1.5 font-mono text-[10px] text-muted">
              <span class="size-1.5 rounded-full bg-mint"></span>
              <span>react-native-android-widget</span>
            </div>
          </div>

          <!-- Card 3: Calendar & Conflict Radar -->
          <div class="flex flex-col justify-between rounded-xl border border-slate-200/80 bg-slate-50/60 p-4 dark:border-white/10 dark:bg-white/[0.02]">
            <div class="space-y-2">
              <div class="flex items-center gap-2 text-mint">
                <Calendar size={16} />
                <span class="font-sans text-xs font-bold text-ink">Calendar &amp; Conflict Radar</span>
              </div>
              <p class="text-[11.5px] leading-relaxed text-muted">
                Month, week, and agenda schedule views with automatic overlap conflict detection and total scheduled hour calculations.
              </p>
            </div>
            <div class="mt-3 flex items-center gap-1.5 font-mono text-[10px] text-muted">
              <span class="size-1.5 rounded-full bg-mint"></span>
              <span>MMKV • Reanimated 4</span>
            </div>
          </div>

          <!-- Card 4: Multi-Niche Flexibility -->
          <div class="flex flex-col justify-between rounded-xl border border-slate-200/80 bg-slate-50/60 p-4 dark:border-white/10 dark:bg-white/[0.02]">
            <div class="space-y-2">
              <div class="flex items-center gap-2 text-mint">
                <Clock size={16} />
                <span class="font-sans text-xs font-bold text-ink">Multi-Niche Adaptation</span>
              </div>
              <p class="text-[11.5px] leading-relaxed text-muted">
                Context-aware fields adapting specifically for shift workers, student timetables, professor teaching loads, and OJT rotations.
              </p>
            </div>
            <div class="mt-3 flex items-center gap-1.5 font-mono text-[10px] text-muted">
              <span class="size-1.5 rounded-full bg-mint"></span>
              <span>Feature-Sliced Design</span>
            </div>
          </div>
        </div>

        <!-- Cover Preview Frame -->
        <figure class="group flex min-w-0 flex-col overflow-hidden rounded-xl border border-slate-200/80 bg-slate-50/60 shadow-xs dark:border-white/10 dark:bg-white/[0.02]">
          <button
            type="button"
            class="image-preview-trigger relative block w-full overflow-hidden bg-bg-deep cursor-pointer focus:outline-none focus:ring-2 focus:ring-mint/60"
            data-gallery="fukurou"
            data-image-src={fukurouCoverImage}
            data-image-alt="Fukurou mobile schedule organizer preview"
            data-image-label="Fukurou — Schedule Import & Shift Management"
            aria-label="Preview Fukurou"
          >
            <img
              src={fukurouCoverImage}
              alt="Fukurou mobile schedule organizer preview"
              class="aspect-[21/9] w-full object-cover object-center transition-transform duration-300 group-hover:scale-[1.02]"
              loading="lazy"
            />
            <div class="absolute inset-0 flex items-center justify-center bg-black/40 opacity-0 backdrop-blur-[1px] transition-opacity duration-200 group-hover:opacity-100">
              <span class="inline-flex items-center gap-1.5 rounded-md border border-white/20 bg-black/70 px-2.5 py-1 text-[11px] font-semibold text-white shadow-md">
                <Maximize2 size={12} />
                <span>View Full Size</span>
              </span>
            </div>
          </button>
          <figcaption class="flex items-center justify-between p-3 border-t border-slate-200/60 bg-white/60 dark:border-white/6 dark:bg-transparent">
            <span class="text-xs font-semibold text-ink">
              Fukurou Mobile System
            </span>
            <span class="font-mono text-[10px] text-muted">
              Screenshots update pending
            </span>
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</div>
