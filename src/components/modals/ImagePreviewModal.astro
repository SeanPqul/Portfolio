---
import { ChevronLeft, ChevronRight, X } from "@lucide/astro";
---

<!-- Image Preview Fullscreen Modal (shadcn style with gallery carousel navigation) -->
<div
  id="image-preview-modal"
  class="fixed inset-0 z-[120] hidden items-center justify-center bg-black/90 p-4 backdrop-blur-md sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="image-preview-title"
>
  <div class="relative flex max-h-[94vh] w-full max-w-5xl flex-col items-center">
    <!-- Close Button -->
    <button
      type="button"
      id="image-preview-close"
      class="absolute -top-12 right-0 z-30 inline-flex items-center gap-1.5 rounded-md border border-white/20 bg-black/70 px-3 py-1.5 text-xs font-semibold text-white shadow-lg backdrop-blur-md transition-all hover:bg-white/20 hover:border-white/40 focus:outline-none focus:ring-2 focus:ring-mint/60 cursor-pointer"
      aria-label="Close image preview"
    >
      <X size={14} />
      <span>Close</span>
    </button>

    <!-- Previous Image Navigation Button -->
    <button
      type="button"
      id="image-preview-prev"
      class="absolute left-2 sm:-left-14 top-1/2 -translate-y-1/2 z-30 inline-flex size-10 sm:size-12 items-center justify-center rounded-full border border-white/20 bg-black/75 text-white shadow-xl backdrop-blur-md transition hover:bg-mint hover:text-[#07100d] hover:border-mint focus:outline-none focus:ring-2 focus:ring-mint/60 cursor-pointer"
      aria-label="Previous image"
    >
      <ChevronLeft size={22} />
    </button>

    <!-- Next Image Navigation Button -->
    <button
      type="button"
      id="image-preview-next"
      class="absolute right-2 sm:-right-14 top-1/2 -translate-y-1/2 z-30 inline-flex size-10 sm:size-12 items-center justify-center rounded-full border border-white/20 bg-black/75 text-white shadow-xl backdrop-blur-md transition hover:bg-mint hover:text-[#07100d] hover:border-mint focus:outline-none focus:ring-2 focus:ring-mint/60 cursor-pointer"
      aria-label="Next image"
    >
      <ChevronRight size={22} />
    </button>

    <!-- Image Box Container -->
    <div class="max-h-[82vh] overflow-auto rounded-xl border border-white/15 bg-[#080d11] p-3 shadow-2xl">
      <img
        id="image-preview-img"
        src=""
        alt=""
        class="mx-auto block max-h-[75vh] min-w-[18rem] max-w-full rounded-lg object-contain transition-opacity duration-200"
      />
    </div>

    <!-- Title & Counter Footer -->
    <div class="mt-3.5 flex flex-wrap items-center justify-center gap-2">
      <p id="image-preview-title" class="rounded-full border border-white/15 bg-black/70 px-3.5 py-1 text-center font-mono text-xs font-semibold uppercase tracking-wider text-white/90 shadow-md backdrop-blur-md"></p>
      <span id="image-preview-counter" class="rounded-full border border-mint/30 bg-mint/10 px-2.5 py-1 text-center font-mono text-[11px] font-semibold text-mint shadow-md backdrop-blur-md"></span>
    </div>
  </div>
</div>
