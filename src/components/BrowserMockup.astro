---
import { Search, Filter, RefreshCw, FileText, CheckCircle, Clock } from "@lucide/astro";
---

<div class="mockup-card glass w-full min-w-0 max-w-full select-none overflow-hidden rounded-2xl border border-white/10 bg-bg-card/90 text-xs text-[#f7f3ea] shadow-2xl">
  <!-- Browser Chrome Top Bar -->
  <div class="flex items-center gap-2 border-b border-white/8 bg-white/[0.02] px-2.5 py-2.5 sm:gap-3 sm:px-4 sm:py-3">
    <div class="flex items-center gap-1.5 shrink-0">
      <span class="size-2.5 rounded-full bg-[#ff5f56]"></span>
      <span class="size-2.5 rounded-full bg-[#ffbd2e]"></span>
      <span class="size-2.5 rounded-full bg-[#27c93f]"></span>
    </div>
    <!-- URL Address Bar -->
    <div class="mx-auto flex min-w-0 flex-1 items-center justify-between gap-2 rounded-lg border border-white/5 bg-[#0b0f14]/60 px-2 py-1 font-mono text-[8px] text-muted sm:max-w-md sm:px-3 sm:text-[10px]">
      <div class="flex items-center gap-1.5 truncate">
        <span class="text-mint">https://</span>
        <span class="truncate">fms.morata-brokerage.com/transactions</span>
      </div>
      <RefreshCw size={8} class="text-muted shrink-0 cursor-pointer hover:text-white" />
    </div>
    <span class="hidden w-10 shrink-0 sm:block"></span> <!-- spacer -->
  </div>

  <!-- App Interface Mockup -->
  <div class="grid h-[230px] grid-cols-1 bg-[#0d1218]/40 sm:h-[250px] sm:grid-cols-[120px_1fr]">
    <!-- Sidebar -->
    <aside class="hidden space-y-4 border-r border-white/6 bg-white/[0.01] p-3 sm:block">
      <div class="flex items-center gap-2 px-1">
        <div class="size-4 rounded bg-mint flex items-center justify-center text-[10px] text-bg-deep font-bold font-mono">&lt;&gt;</div>
        <span class="font-bold text-[10px] tracking-wide uppercase text-mint">MorataFMS</span>
      </div>
      <nav class="space-y-1">
        <span class="flex items-center gap-2 rounded bg-white/5 px-2 py-1.5 text-[10px] font-semibold text-white">
          <FileText size={10} class="text-mint" /> Transactions
        </span>
        <span class="flex items-center gap-2 px-2 py-1.5 text-[10px] font-medium text-muted hover:text-white transition cursor-pointer">
          <Clock size={10} /> Active Files
        </span>
        <span class="flex items-center gap-2 px-2 py-1.5 text-[10px] font-medium text-muted hover:text-white transition cursor-pointer">
          <CheckCircle size={10} /> Approvals
        </span>
      </nav>
    </aside>

    <!-- Main Content Panel -->
    <main class="flex min-w-0 flex-col gap-3 overflow-hidden p-2.5 sm:p-3">
      <!-- Toolbar -->
      <div class="flex flex-col gap-2 min-[430px]:flex-row min-[430px]:items-center min-[430px]:justify-between">
        <div class="flex min-w-0 flex-1 items-center gap-2 rounded border border-white/5 bg-[#0b0f14]/50 px-2 py-1 min-[430px]:max-w-[150px]">
          <Search size={10} class="text-muted" />
          <span class="text-muted text-[10px]">Search files...</span>
        </div>
        <div class="flex flex-wrap gap-1">
          <span class="flex items-center gap-1 rounded border border-white/10 bg-white/[0.02] px-1.5 py-0.5 text-[9px] font-medium text-muted">
            <Filter size={8} /> Filters
          </span>
          <span class="rounded bg-mint text-bg-deep px-1.5 py-0.5 text-[9px] font-bold">
            + New Record
          </span>
        </div>
      </div>

      <!-- Transaction Table -->
      <div class="flex-1 overflow-y-auto border border-white/8 rounded-lg bg-bg-deep/30">
        <table class="w-full table-fixed border-collapse text-left">
          <thead>
            <tr class="border-b border-white/8 bg-white/[0.02] text-[9px] text-muted font-semibold">
              <th class="w-[42%] p-2 sm:w-[32%]">Reference</th>
              <th class="hidden p-2 sm:table-cell">Client / Goods</th>
              <th class="w-[58%] p-2 sm:w-[34%]">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 text-[10px]">
            <tr class="hover:bg-white/[0.02] transition">
              <td class="p-2 font-mono text-amber">M-2026-085</td>
              <td class="hidden p-2 sm:table-cell">
                <div class="font-bold text-white">Nippon Trading</div>
                <div class="text-[8px] text-muted">Electronics / Tokyo</div>
              </td>
              <td class="p-2">
                <span class="inline-flex max-w-full items-center gap-1 rounded-full border border-amber/20 bg-amber/10 px-1.5 py-0.5 text-[8px] font-bold text-amber">
                  <span class="size-1 rounded-full bg-amber animate-pulse"></span>
                  <span class="truncate">Customs Verification</span>
                </span>
              </td>
            </tr>
            <tr class="hover:bg-white/[0.02] transition">
              <td class="p-2 font-mono text-sky">M-2026-084</td>
              <td class="hidden p-2 sm:table-cell">
                <div class="font-bold text-white">Apex Steel Corp</div>
                <div class="text-[8px] text-muted">Raw Metal / Seattle</div>
              </td>
              <td class="p-2">
                <span class="inline-flex max-w-full items-center gap-1 rounded-full border border-sky/20 bg-sky/10 px-1.5 py-0.5 text-[8px] font-bold text-sky">
                  <span class="size-1 rounded-full bg-sky"></span>
                  <span class="truncate">In Transit</span>
                </span>
              </td>
            </tr>
            <tr class="hover:bg-white/[0.02] transition">
              <td class="p-2 font-mono text-mint">M-2026-081</td>
              <td class="hidden p-2 sm:table-cell">
                <div class="font-bold text-white">Pacific Logistics</div>
                <div class="text-[8px] text-muted">Agricultural / Sydney</div>
              </td>
              <td class="p-2">
                <span class="inline-flex max-w-full items-center gap-1 rounded-full border border-mint/20 bg-mint/10 px-1.5 py-0.5 text-[8px] font-bold text-mint">
                  <span class="size-1 rounded-full bg-mint"></span>
                  <span class="truncate">Approved & Released</span>
                </span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </main>
  </div>
</div>
