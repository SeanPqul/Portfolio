---
import { Globe, Smartphone, Code, Camera, Disc, ShieldCheck, Focus } from "@lucide/astro";
---

<div class="relative mx-auto flex min-h-[420px] w-full max-w-[430px] flex-col items-center justify-center overflow-visible px-2 py-6 sm:min-h-[460px] sm:px-4 lg:max-w-none">
  
  <!-- Backlight Glow Blobs -->
  <div class="absolute top-1/2 left-1/3 -translate-x-1/2 -translate-y-1/2 w-48 h-48 bg-mint/5 rounded-full blur-3xl pointer-events-none animate-pulse-glow"></div>
  <div class="absolute top-1/2 right-1/3 translate-x-1/2 -translate-y-1/2 w-48 h-48 bg-sky/5 rounded-full blur-3xl pointer-events-none animate-pulse-glow" style="animation-delay: 2s;"></div>

  <!-- Central Camera Viewfinder Deck Container -->
  <div class="relative z-10 flex w-[min(68vw,245px)] flex-col items-center select-none sm:w-[290px] lg:w-[270px] xl:w-[290px]">
    
    <!-- Camera Viewfinder Screen -->
    <div 
      id="profile-card-container"
      class="relative w-full aspect-[4/5] sm:aspect-[3/4] rounded-2xl border border-white/12 bg-black overflow-hidden shadow-2xl group/photo transition-all duration-500 hover:border-mint/30 hover:shadow-mint/5 cursor-pointer"
      title="Click to cycle photoshoot images"
      role="button"
      tabindex="0"
      aria-label="Focus portrait"
    >
      <!-- Shutter flash overlay -->
      <div id="deck-shutter-flash" class="absolute inset-0 bg-white opacity-0 z-40 pointer-events-none transition-opacity duration-75"></div>

      <!-- Grain texture overlay -->
      <div class="absolute inset-0 grain opacity-8 pointer-events-none z-20"></div>

      <!-- Rule of Thirds Gridlines -->
      <div id="grid-lines" class="absolute inset-0 grid grid-cols-3 grid-rows-3 pointer-events-none z-10 opacity-15 transition-opacity duration-700">
        <div class="border-r border-b border-dashed border-white/30"></div>
        <div class="border-r border-b border-dashed border-white/30"></div>
        <div class="border-b border-dashed border-white/30"></div>
        <div class="border-r border-b border-dashed border-white/30"></div>
        <div class="border-r border-b border-dashed border-white/30"></div>
        <div class="border-b border-dashed border-white/30"></div>
        <div class="border-r border-dashed border-white/30"></div>
        <div class="border-r border-dashed border-white/30"></div>
        <div></div>
      </div>

      <!-- Viewfinder Overlay Info (RAW/4K, Autofocus Brackets) -->
      <div class="absolute inset-0 p-3.5 z-20 font-mono text-[8px] font-bold text-ink pointer-events-none tracking-wider">
        <!-- Top Row -->
        <div class="flex items-center justify-end w-full">
          <div class="flex items-center gap-1 bg-black/45 px-1 py-0.5 rounded text-[7px]">
            <span>RAW</span>
            <span class="text-sky font-normal">4K 60</span>
          </div>
        </div>

        <!-- Center Autofocus Brackets -->
        <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 flex items-center justify-center">
          <div 
            id="af-box" 
            class="relative w-12 h-12 border border-white/30 rounded transition-all duration-300 ease-out scale-100 flex items-center justify-center"
          >
            <!-- Center AF dot -->
            <div id="af-dot" class="w-1 h-1 bg-white/40 rounded-full transition-colors"></div>
            <!-- Technical AF corner accents -->
            <span class="absolute -top-[1px] -left-[1px] w-2.5 h-2.5 border-t border-l border-amber transition-colors" id="af-c1"></span>
            <span class="absolute -top-[1px] -right-[1px] w-2.5 h-2.5 border-t border-r border-amber transition-colors" id="af-c2"></span>
            <span class="absolute -bottom-[1px] -left-[1px] w-2.5 h-2.5 border-b border-l border-amber transition-colors" id="af-c3"></span>
            <span class="absolute -bottom-[1px] -right-[1px] w-2.5 h-2.5 border-b border-r border-amber transition-colors" id="af-c4"></span>
          </div>
          
          <div id="hud-focus-status" class="absolute top-8 text-[6px] bg-amber/10 border border-amber/20 text-amber px-1 rounded opacity-0 transition-opacity duration-300 whitespace-nowrap">
            AF-S LOCK
          </div>
        </div>
      </div>

      <!-- Bottom DSLR Viewfinder Status Bar (Full width, no inset padding, solid background matching real DSLR viewfinders) -->
      <div class="absolute bottom-0 left-0 right-0 z-20 bg-[#070b0e]/95 border-t border-white/8 px-3.5 py-2 font-mono text-[8px] font-bold text-ink pointer-events-none tracking-wider flex flex-col gap-1 rounded-b-2xl">
        <!-- Exposure Scale -->
        <div class="flex justify-center items-center gap-1 opacity-70 text-[7px]">
          <span>-2</span>
          <span>·</span>
          <span>-1</span>
          <span>·</span>
          <span class="text-amber">0</span>
          <span>·</span>
          <span>+1</span>
          <span>·</span>
          <span>+2</span>
        </div>
        
        <div class="flex items-center justify-between text-[7px] sm:text-[8px]">
          <div class="flex items-center gap-2">
            <span>SS: <span class="text-mint font-normal">1/125</span></span>
            <span>F: <span class="text-mint font-normal">2.8</span></span>
            <span>ISO: <span class="text-mint font-normal">400</span></span>
          </div>
          <div class="flex items-center gap-1">
            <span>BATT</span>
            <div class="w-5 h-2.5 border border-white/30 rounded-2xs p-0.2 flex items-center">
              <div class="h-full w-4/5 bg-mint rounded-3xs"></div>
            </div>
            <span>88%</span>
          </div>
        </div>
      </div>
      
      <!-- Image -->
      <img 
        id="profile-card-image"
        src="/profile.jpg" 
        alt="Sean Paul Lapasanda portrait" 
        class="w-full h-full object-cover object-[16%_25%] transition-all duration-700 ease-out"
        style="transform: scale(1); filter: blur(2px) contrast(0.95);"
      />
    </div>
  </div>

  <!-- FLOATING BADGES (Preserving Orbiting Layer Depth) -->
  <!-- FLOATING BADGE 1: Web Systems (Top Right) -->
  <div class="hero-float-badge hero-float-badge-web pointer-events-auto absolute right-0 top-3 z-20 animate-float sm:-right-6 sm:top-2 lg:-right-8 lg:top-4 xl:-right-11 xl:top-3">
    <article class="glass w-[112px] rounded-xl border border-white/8 p-2.5 text-left transition-all duration-300 hover:scale-105 hover:border-sky/30 hover:bg-sky/5 hover:shadow-lg hover:shadow-sky/5 sm:w-[140px] sm:p-3 lg:w-[125px] xl:w-[140px]">
      <div class="flex items-center gap-1.5 mb-1">
        <span class="grid size-5 place-items-center rounded bg-sky/10 border border-sky/20 text-sky">
          <Globe size={11} />
        </span>
        <span class="text-[8px] font-mono font-bold text-sky uppercase tracking-wider">Solutions</span>
      </div>
      <p class="text-xs font-extrabold font-display text-ink leading-tight">Web Systems</p>
      <p class="text-[7px] text-muted leading-tight mt-0.5">Dashboards & workflows</p>
    </article>
  </div>

  <!-- FLOATING BADGE 2: Mobile Apps (Middle Left) -->
  <div class="hero-float-badge hero-float-badge-mobile pointer-events-auto absolute left-0 top-1/3 z-20 animate-float-delayed sm:-left-6 lg:-left-8 lg:top-[38%] xl:-left-11">
    <article class="glass w-[112px] rounded-xl border border-white/8 p-2.5 text-left transition-all duration-300 hover:scale-105 hover:border-mint/30 hover:bg-mint/5 hover:shadow-lg hover:shadow-mint/5 sm:w-[140px] sm:p-3 lg:w-[125px] xl:w-[140px]">
      <div class="flex items-center gap-1.5 mb-1">
        <span class="grid size-5 place-items-center rounded bg-mint/10 border border-mint/20 text-mint">
          <Smartphone size={11} />
        </span>
        <span class="text-[8px] font-mono font-bold text-mint uppercase tracking-wider">Mobile</span>
      </div>
      <p class="text-xs font-extrabold font-display text-ink leading-tight">Mobile Apps</p>
      <p class="text-[7px] text-muted leading-tight mt-0.5">Cross-platform products</p>
    </article>
  </div>

  <!-- FLOATING BADGE 3: Tech Stack (Bottom Right) -->
  <div class="hero-float-badge hero-float-badge-stack pointer-events-auto absolute bottom-8 right-0 z-20 animate-float sm:-right-6 sm:bottom-6 lg:-right-8 lg:bottom-2 xl:-right-11 xl:bottom-0" style="animation-delay: 1.5s;">
    <article class="glass w-[112px] rounded-xl border border-white/8 p-2.5 text-left transition-all duration-300 hover:scale-105 hover:border-amber/30 hover:bg-amber/5 hover:shadow-lg hover:shadow-amber/5 sm:w-[140px] sm:p-3 lg:w-[125px] xl:w-[140px]">
      <div class="flex items-center gap-1.5 mb-1">
        <span class="grid size-5 place-items-center rounded bg-amber/10 border border-amber/20 text-amber">
          <Code size={11} />
        </span>
        <span class="text-[8px] font-mono font-bold text-amber uppercase tracking-wider">Tech Stack</span>
      </div>
      <p class="text-xs font-extrabold font-display text-ink leading-tight">Laravel & React</p>
      <p class="text-[7px] text-muted leading-tight mt-0.5">APIs · data · UI systems</p>
    </article>
  </div>

</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("profile-card-container");
    const img = document.getElementById("profile-card-image") as HTMLImageElement;
    const flash = document.getElementById("deck-shutter-flash");
    const gridLines = document.getElementById("grid-lines");
    const hudFocusStatus = document.getElementById("hud-focus-status");
    
    const afBox = document.getElementById("af-box");
    const afDot = document.getElementById("af-dot");
    const afCornerElements = [
      document.getElementById("af-c1"),
      document.getElementById("af-c2"),
      document.getElementById("af-c3"),
      document.getElementById("af-c4")
    ];

    if (!container || !img) return;

    // Photoshoot images with coordinates & specific zoom targets for focus modes
    const images = [
      { src: "/profile.jpg", pos: "16% 25%", zoom: "scale(1.7) translate(14%, 8%)" },
      { src: "/profile-2.jpg", pos: "16% 25%", zoom: "scale(1.7) translate(14%, 8%)" },
      { src: "/profile-3.jpg", pos: "68% 15%", zoom: "scale(1.65) translate(-14%, 6%)" },
      { src: "/profile-4.jpg", pos: "50% 15%", zoom: "scale(1.6) translate(0%, 6%)" }
    ];

    let currentIndex = 0;
    let isTransitioning = false;
    let isFocused = false;
    let autoFocusTimer: ReturnType<typeof setTimeout> | null = null;
    const touchQuery = window.matchMedia("(hover: none), (pointer: coarse)");

    function usesTouchFlow() {
      return touchQuery.matches;
    }

    function updateInteractionLabel() {
      if (!container) return;

      if (usesTouchFlow()) {
        container.setAttribute("aria-label", isFocused ? "Take next photo" : "Focus portrait");
        return;
      }

      container.setAttribute("aria-label", "Cycle photoshoot images");
    }

    // A. Apply focus or blur style dynamically
    function applyFocusStyles() {
      if (isFocused) {
        img.style.transform = images[currentIndex].zoom;
        img.style.filter = "blur(0px) contrast(1.05) saturate(1.02)";
      } else {
        img.style.transform = "scale(1) translate(0, 0)";
        img.style.filter = "blur(2px) contrast(0.95)";
      }
    }

    // B. AF Trigger
    function toggleFocus(forceState?: boolean) {
      isFocused = forceState !== undefined ? forceState : !isFocused;

      if (autoFocusTimer) clearTimeout(autoFocusTimer);

      if (isFocused) {
        if (afBox) {
          afBox.classList.remove("scale-100");
          afBox.classList.add("scale-115");
          afBox.style.borderColor = "rgba(246, 197, 111, 0.6)";
        }
        afCornerElements.forEach(el => {
          if (el) el.style.borderColor = "var(--color-amber)";
        });

        autoFocusTimer = setTimeout(() => {
          applyFocusStyles();
          
          if (afBox) {
            afBox.classList.remove("scale-115");
            afBox.classList.add("scale-95");
            afBox.style.borderColor = "rgba(102, 224, 181, 0.4)";
          }
          if (afDot) afDot.style.backgroundColor = "var(--color-mint)";
          afCornerElements.forEach(el => {
            if (el) el.style.borderColor = "var(--color-mint)";
          });
          if (gridLines) gridLines.style.opacity = "0.03";
          if (hudFocusStatus) {
            hudFocusStatus.style.opacity = "1";
            hudFocusStatus.classList.remove("text-amber", "bg-amber/10", "border-amber/20");
            hudFocusStatus.classList.add("text-mint", "bg-mint/10", "border-mint/20");
            hudFocusStatus.textContent = "AF-S LOCKED";
          }
        }, 400);

      } else {
        if (autoFocusTimer) clearTimeout(autoFocusTimer);
        applyFocusStyles();
        
        if (afBox) {
          afBox.classList.remove("scale-95", "scale-115");
          afBox.classList.add("scale-100");
          afBox.style.borderColor = "rgba(255, 255, 255, 0.3)";
        }
        if (afDot) afDot.style.backgroundColor = "rgba(255, 255, 255, 0.4)";
        afCornerElements.forEach(el => {
          if (el) el.style.borderColor = "var(--color-amber)";
        });
        if (gridLines) gridLines.style.opacity = "0.15";
        if (hudFocusStatus) hudFocusStatus.style.opacity = "0";
      }

      updateInteractionLabel();
    }

    function shootNextPhoto({ resetFocusAfterShot = false } = {}) {
      if (isTransitioning) return;
      isTransitioning = true;

      // Shutter flash effect
      if (flash) {
        flash.style.opacity = "1";
        setTimeout(() => {
          flash.style.opacity = "0";
        }, 80);
      }

      // Temporarily disable transition to prevent sliding/panning during swap
      img.style.transition = "none";
      img.style.opacity = "0.1";

      setTimeout(() => {
        currentIndex = (currentIndex + 1) % images.length;
        img.src = images[currentIndex].src;
        img.style.objectPosition = images[currentIndex].pos;

        if (resetFocusAfterShot) {
          toggleFocus(false);
        } else {
          applyFocusStyles();
        }

        img.onload = () => {
          // Re-enable transition before fading in so it is smooth
          img.style.transition = "";
          // Force layout reflow to register the transition change
          void img.offsetHeight;
          img.style.opacity = "1";
          isTransitioning = false;
          updateInteractionLabel();
        };

        setTimeout(() => {
          if (isTransitioning) {
            img.style.transition = "";
            void img.offsetHeight;
            img.style.opacity = "1";
            isTransitioning = false;
            updateInteractionLabel();
          }
        }, 150);

      }, 150);
    }

    // C. Click to focus on touch, and shutter on the next tap.
    container.addEventListener("click", () => {
      if (isTransitioning) return;

      if (usesTouchFlow()) {
        if (!isFocused) {
          toggleFocus(true);
          return;
        }

        shootNextPhoto({ resetFocusAfterShot: true });
        return;
      }

      shootNextPhoto();
    });

    // D. Hover Auto-focus Trigger
    container.addEventListener("mouseenter", () => {
      if (usesTouchFlow()) return;
      if (!isFocused) toggleFocus(true);
    });

    container.addEventListener("mouseleave", () => {
      if (usesTouchFlow()) return;
      toggleFocus(false);
    });

    container.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" && event.key !== " ") return;

      event.preventDefault();
      if (!isFocused) {
        toggleFocus(true);
        return;
      }

      shootNextPhoto({ resetFocusAfterShot: true });
    });

    touchQuery.addEventListener("change", updateInteractionLabel);
    updateInteractionLabel();
  });
</script>
