---
import { GraduationCap, Briefcase, Code, ShieldCheck, Camera } from "@lucide/astro";
---

<div class="relative w-full flex items-center justify-center py-10 px-6 sm:px-10 overflow-visible min-h-[420px]">
  
  <!-- Backlight Glow Blobs -->
  <div class="absolute top-1/2 left-1/3 -translate-x-1/2 -translate-y-1/2 w-48 h-48 bg-mint/10 rounded-full blur-3xl pointer-events-none animate-pulse-glow"></div>
  <div class="absolute top-1/2 right-1/3 translate-x-1/2 -translate-y-1/2 w-48 h-48 bg-sky/10 rounded-full blur-3xl pointer-events-none animate-pulse-glow" style="animation-delay: 2s;"></div>

  <!-- Decorative Overlapping Card Frames behind main photo -->
  <div class="absolute w-52 h-[320px] sm:w-56 sm:h-[340px] rounded-3xl border border-white/5 bg-white/[0.01] rotate-3 translate-x-4 translate-y-2 pointer-events-none transition-transform duration-500 group-hover/deck:rotate-6"></div>
  <div class="absolute w-52 h-[320px] sm:w-56 sm:h-[340px] rounded-3xl border border-white/5 bg-white/[0.01] -rotate-2 -translate-x-2 -translate-y-1 pointer-events-none transition-transform duration-500 group-hover/deck:-rotate-4"></div>

  <!-- Central Portrait Image Card (Clickable to cycle) -->
  <div 
    id="profile-card-container"
    class="relative w-52 h-[320px] sm:w-56 sm:h-[340px] rounded-3xl border border-white/12 bg-[#0b0f14] overflow-hidden shadow-2xl z-10 group/photo transition-all duration-500 hover:border-mint/30 hover:shadow-mint/5 cursor-pointer"
    title="Click to cycle photoshoot images"
  >
    <!-- Shutter shutter flash simulation overlay -->
    <div id="deck-shutter-flash" class="absolute inset-0 bg-white opacity-0 z-40 pointer-events-none transition-opacity duration-75"></div>

    <!-- Grain texture overlay -->
    <div class="absolute inset-0 grain opacity-8 pointer-events-none z-20"></div>

    <!-- Hover Indicator Overlay -->
    <div class="absolute inset-0 bg-black/55 opacity-0 group-hover/photo:opacity-100 transition-all duration-300 flex flex-col items-center justify-center gap-1.5 z-30 pointer-events-none">
      <div class="size-10 rounded-full bg-white/10 border border-white/20 flex items-center justify-center text-mint scale-95 group-hover/photo:scale-100 transition-transform duration-300">
        <Camera class="size-5 text-mint" />
      </div>
      <span class="text-[9px] font-bold font-display uppercase tracking-widest text-ink">Cycle Photo</span>
    </div>

    <!-- Radial shading overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-bg-deep via-transparent to-transparent opacity-85 z-10 pointer-events-none"></div>
    <div class="absolute inset-x-0 bottom-0 px-4 py-4 z-20 pointer-events-none text-left">
      <p class="font-display font-extrabold text-sm tracking-wide text-ink">Sean Paul S. Lapasanda</p>
      <p class="text-[9px] font-mono text-muted uppercase tracking-widest mt-0.5" id="profile-card-index">Photo 1 of 4</p>
    </div>

    <!-- The cropped graduation photo -->
    <img 
      id="profile-card-image"
      src="/profile.jpg" 
      alt="Sean Paul Lapasanda graduation portrait" 
      class="w-full h-full object-cover object-[16%_25%] transition-all duration-500 ease-out hover:scale-103"
      style="opacity: 1;"
    />
  </div>

  <!-- FLOATING BADGE 1: BSIT Graduate (Top Left) -->
  <div 
    class="absolute top-6 left-2 sm:-left-6 z-20 animate-float pointer-events-auto"
  >
    <article class="glass rounded-xl p-3 border border-white/8 hover:border-sky/30 hover:bg-sky/5 transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-sky/5 w-[145px] sm:w-[160px] text-left">
      <div class="flex items-center gap-2 mb-1">
        <span class="grid size-6 place-items-center rounded-lg bg-sky/10 border border-sky/20 text-sky">
          <GraduationCap size={13} />
        </span>
        <span class="text-[9px] font-mono font-bold text-sky uppercase tracking-wider">Education</span>
      </div>
      <p class="text-xs font-bold text-ink">BSIT Graduate</p>
      <p class="text-[8px] text-muted leading-tight mt-0.5">STI College Davao (2022 — 2026)</p>
    </article>
  </div>

  <!-- FLOATING BADGE 2: OJT Developer (Top Right) -->
  <div 
    class="absolute top-12 right-2 sm:-right-6 z-20 animate-float-delayed pointer-events-auto"
  >
    <article class="glass rounded-xl p-3 border border-white/8 hover:border-mint/30 hover:bg-mint/5 transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-mint/5 w-[145px] sm:w-[160px] text-left">
      <div class="flex items-center gap-2 mb-1">
        <span class="grid size-6 place-items-center rounded-lg bg-mint/10 border border-mint/20 text-mint">
          <Briefcase size={13} />
        </span>
        <span class="text-[9px] font-mono font-bold text-mint uppercase tracking-wider">Internship</span>
      </div>
      <p class="text-xs font-bold text-ink">OJT Developer</p>
      <p class="text-[8px] text-muted leading-tight mt-0.5">F.M. Morata Law Firm (Laravel/React)</p>
    </article>
  </div>

  <!-- FLOATING BADGE 3: Laravel & React Core Stack (Bottom Left) -->
  <div 
    class="absolute bottom-16 left-0 sm:-left-8 z-20 animate-float pointer-events-auto"
    style="animation-delay: 1.5s;"
  >
    <article class="glass rounded-xl p-3 border border-white/8 hover:border-amber/30 hover:bg-amber/5 transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-amber/5 w-[145px] sm:w-[160px] text-left">
      <div class="flex items-center gap-2 mb-1">
        <span class="grid size-6 place-items-center rounded-lg bg-amber/10 border border-amber/20 text-amber">
          <Code size={13} />
        </span>
        <span class="text-[9px] font-mono font-bold text-amber uppercase tracking-wider">Core Stacks</span>
      </div>
      <p class="text-xs font-bold text-ink">Laravel & React</p>
      <p class="text-[8px] text-muted leading-tight mt-0.5">Web APIs & Mobile React Native apps</p>
    </article>
  </div>

  <!-- FLOATING BADGE 4: TESDA NC II CSS (Bottom Right) -->
  <div 
    class="absolute bottom-10 right-0 sm:-right-8 z-20 animate-float-delayed pointer-events-auto"
    style="animation-delay: 0.5s;"
  >
    <article class="glass rounded-xl p-3 border border-white/8 hover:border-[#a78bfa]/30 hover:bg-[#a78bfa]/5 transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-[#a78bfa]/5 w-[145px] sm:w-[160px] text-left">
      <div class="flex items-center gap-2 mb-1">
        <span class="grid size-6 place-items-center rounded-lg bg-[#a78bfa]/10 border border-[#a78bfa]/20 text-[#a78bfa]">
          <ShieldCheck size={13} />
        </span>
        <span class="text-[9px] font-mono font-bold text-[#a78bfa] uppercase tracking-wider">Credential</span>
      </div>
      <p class="text-xs font-bold text-ink">NC II CSS Certified</p>
      <p class="text-[8px] text-muted leading-tight mt-0.5">TESDA computer systems servicing</p>
    </article>
  </div>

</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("profile-card-container");
    const img = document.getElementById("profile-card-image") as HTMLImageElement;
    const flash = document.getElementById("deck-shutter-flash");
    const indexText = document.getElementById("profile-card-index");
    
    if (!container || !img) return;

    // Photoshoot image array with dynamic cropping coordinates tailored for each picture
    const images = [
      { src: "/profile.jpg", pos: "16% 25%" },   // Original portrait
      { src: "/profile-2.jpg", pos: "16% 25%" }, // Portrait with name whiteboard
      { src: "/profile-3.jpg", pos: "68% 15%" }, // Group photo, Sean holding thesis
      { src: "/profile-4.jpg", pos: "50% 15%" }  // Group photo, Sean kneeling in front
    ];

    let currentIndex = 0;
    let isTransitioning = false;

    container.addEventListener("click", () => {
      if (isTransitioning) return;
      isTransitioning = true;

      // 1. Shutter Flash Effect
      if (flash) {
        flash.style.opacity = "1";
        setTimeout(() => {
          flash.style.opacity = "0";
        }, 80);
      }

      // 2. Fade Out current image
      img.style.opacity = "0.2";
      img.style.transform = "scale(0.98)";

      setTimeout(() => {
        // 3. Cycle Index
        currentIndex = (currentIndex + 1) % images.length;

        // 4. Swap source and positions
        img.src = images[currentIndex].src;
        img.style.objectPosition = images[currentIndex].pos;
        if (indexText) {
          indexText.textContent = `Photo ${currentIndex + 1} of ${images.length}`;
        }

        // 5. Fade back in
        img.onload = () => {
          img.style.opacity = "1";
          img.style.transform = "scale(1)";
          isTransitioning = false;
        };

        // Fallback for cached images where onload might not trigger
        setTimeout(() => {
          if (isTransitioning) {
            img.style.opacity = "1";
            img.style.transform = "scale(1)";
            isTransitioning = false;
          }
        }, 150);

      }, 150);
    });

  });
</script>
