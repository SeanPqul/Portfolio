---
import { ExternalLink } from "@lucide/astro";

interface ContributionDay {
  date: string;
  count: number;
  level: number;
}

interface ApiResponse {
  total: Record<string, number>;
  contributions: ContributionDay[];
}

const username = "SeanPqul";
const profileUrl = `https://github.com/${username}`;

// Fallback data in case the build-time API call is unavailable or times out
const fallbackTotal: Record<string, number> = {
  "2026": 378,
  "2025": 240,
  "2024": 1,
  "2023": 1,
};

let allContributions: ContributionDay[] = [];
let totalContributionsByYear: Record<string, number> = fallbackTotal;

try {
  const res = await fetch(`https://github-contributions-api.jogruber.de/v4/${username}`, {
    signal: AbortSignal.timeout(6000),
  });
  if (res.ok) {
    const data: ApiResponse = await res.json();
    if (data && data.contributions && data.total) {
      allContributions = data.contributions;
      totalContributionsByYear = data.total;
    }
  }
} catch (err) {
  // If build-time fetch fails, fallback gracefully
}

// Available years sorted descending
const availableYears = Object.keys(totalContributionsByYear)
  .filter((y) => Number(y) >= 2023)
  .sort((a, b) => Number(b) - Number(a));

const defaultYear = availableYears[0] || "2026";
const defaultTotal = totalContributionsByYear[defaultYear] ?? 378;

// Group contributions by year
const contributionsByYear: Record<string, ContributionDay[]> = {};
for (const year of availableYears) {
  contributionsByYear[year] = allContributions.filter((d) => d.date.startsWith(year));
}

// Helper to structure a year's days into 53 weeks x 7 days
function buildYearGrid(year: string, days: ContributionDay[]) {
  const dayMap = new Map<string, ContributionDay>();
  days.forEach((d) => dayMap.set(d.date, d));

  const startDate = new Date(`${year}-01-01T00:00:00Z`);
  const endDate = new Date(`${year}-12-31T23:59:59Z`);

  // Start from the Sunday preceding or on Jan 1
  const startDayOfWeek = startDate.getUTCDay(); // 0 = Sun, 1 = Mon ...
  const gridStart = new Date(startDate);
  gridStart.setUTCDate(startDate.getUTCDate() - startDayOfWeek);

  const weeks: { days: { date: string; count: number; level: number; inYear: boolean }[] }[] = [];
  const monthHeaders: { label: string; weekIndex: number }[] = [];

  const curr = new Date(gridStart);
  let lastMonth = -1;
  let weekIndex = 0;

  while (curr <= endDate || curr.getUTCDay() !== 0) {
    const weekDays = [];
    for (let i = 0; i < 7; i++) {
      const dateStr = curr.toISOString().split("T")[0];
      const inYear = curr.getUTCFullYear() === Number(year);
      const dayData = dayMap.get(dateStr);

      // Track first occurrence of a month
      if (inYear && curr.getUTCMonth() !== lastMonth && curr.getUTCDate() <= 14) {
        lastMonth = curr.getUTCMonth();
        const monthLabel = curr.toLocaleString("en-US", { month: "short", timeZone: "UTC" });
        monthHeaders.push({ label: monthLabel, weekIndex });
      }

      weekDays.push({
        date: dateStr,
        count: dayData ? dayData.count : 0,
        level: dayData ? dayData.level : 0,
        inYear,
      });

      curr.setUTCDate(curr.getUTCDate() + 1);
    }
    weeks.push({ days: weekDays });
    weekIndex++;
  }

  return { weeks, monthHeaders };
}

const initialGrid = buildYearGrid(defaultYear, contributionsByYear[defaultYear] || []);
---

<div class="scroll-reveal glass relative overflow-hidden rounded-2xl border border-white/10 p-5 sm:p-7 md:p-8 transition-all hover:border-mint/20">
  
  <!-- Subtle ambient glow in top corner -->
  <div class="absolute -right-16 -top-16 size-48 rounded-full bg-mint/5 blur-3xl pointer-events-none"></div>

  <!-- Header Row: Title & Year Tabs -->
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <div class="flex items-center gap-2">
        <!-- GitHub SVG Icon -->
        <svg class="size-4.5 text-mint" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
        <span class="text-[11px] font-mono font-bold uppercase tracking-widest text-mint">GitHub Activity</span>
      </div>
      <h3 class="mt-1 font-display text-2xl font-extrabold text-ink sm:text-3xl">
        <span id="gh-total-count">{defaultTotal}</span> contributions in <span id="gh-selected-year">{defaultYear}</span>
      </h3>
    </div>

    <!-- Year Tabs & Profile Button -->
    <div class="flex flex-wrap items-center gap-2">
      <!-- Year Switcher Buttons -->
      <div 
        id="gh-year-tabs" 
        class="inline-flex items-center rounded-full border border-white/8 bg-white/[0.03] p-1 text-xs"
        role="tablist"
        aria-label="Filter contributions by year"
      >
        {
          availableYears.map((year, idx) => (
            <button
              type="button"
              class={`gh-year-btn rounded-full px-3 py-1 font-mono font-semibold transition-all ${
                idx === 0
                  ? "bg-mint text-[#07100d] font-bold shadow-sm"
                  : "text-muted hover:text-ink"
              }`}
              data-year={year}
              role="tab"
              aria-selected={idx === 0 ? "true" : "false"}
            >
              {year}
            </button>
          ))
        }
      </div>

      <!-- View Profile External Link -->
      <a
        href={profileUrl}
        target="_blank"
        rel="noreferrer"
        class="inline-flex min-h-8 items-center gap-1.5 rounded-full border border-white/8 bg-white/[0.02] px-3.5 py-1 text-xs font-semibold text-muted transition hover:border-mint hover:text-mint"
      >
        <span>View profile</span>
        <ExternalLink size={13} />
      </a>
    </div>
  </div>

  <!-- Heatmap Container Area -->
  <div class="mt-6 w-full overflow-x-auto pb-2 select-none scrollbar-thin scrollbar-thumb-white/10" id="gh-scroll-container">
    <div class="min-w-[680px] w-full flex flex-col gap-1.5" id="gh-heatmap-wrapper">
      
      <!-- Month Labels Row -->
      <div class="flex text-[10px] font-mono text-muted pl-7 pr-1 justify-between select-none" id="gh-month-labels">
        {
          ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"].map((m) => (
            <span class="w-8 text-left">{m}</span>
          ))
        }
      </div>

      <!-- Grid Body (Day Labels + Week Columns) -->
      <div class="flex items-start gap-2">
        <!-- Day of Week Labels (Mon, Wed, Fri) -->
        <div class="flex flex-col justify-between text-[9px] font-mono text-muted/70 h-[92px] sm:h-[105px] pt-1.5 pb-1 select-none">
          <span>Mon</span>
          <span>Wed</span>
          <span>Fri</span>
        </div>

        <!-- 53 Week Columns Heatmap -->
        <div 
          id="gh-grid" 
          class="flex flex-1 gap-[3px] sm:gap-1"
          data-all-contributions={JSON.stringify(contributionsByYear)}
          data-all-totals={JSON.stringify(totalContributionsByYear)}
        >
          {
            initialGrid.weeks.map((week) => (
              <div class="flex flex-col gap-[3px] sm:gap-1 flex-1">
                {week.days.map((day) => (
                  <div
                    class={`gh-cell aspect-square w-full rounded-[2.5px] sm:rounded-[3px] transition-all duration-200 hover:scale-125 hover:z-30 cursor-pointer ${
                      day.inYear ? `gh-cell-${day.level}` : "opacity-0 pointer-events-none"
                    }`}
                    data-date={day.date}
                    data-count={day.count}
                    data-level={day.level}
                  />
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- Footer Legend & Info -->
  <div class="mt-4 flex flex-col gap-3 border-t border-white/6 pt-4 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-2">
      <span class="size-2 rounded-full bg-mint animate-pulse"></span>
      <span class="font-mono text-[11px]">Active public & private repository commits</span>
    </div>

    <!-- Intensity Scale Legend -->
    <div class="flex items-center gap-1.5 font-mono text-[10px] select-none">
      <span>Less</span>
      <span class="gh-cell gh-cell-0 size-2.5 sm:size-3 rounded-[2px]"></span>
      <span class="gh-cell gh-cell-1 size-2.5 sm:size-3 rounded-[2px]"></span>
      <span class="gh-cell gh-cell-2 size-2.5 sm:size-3 rounded-[2px]"></span>
      <span class="gh-cell gh-cell-3 size-2.5 sm:size-3 rounded-[2px]"></span>
      <span class="gh-cell gh-cell-4 size-2.5 sm:size-3 rounded-[2px]"></span>
      <span>More</span>
    </div>
  </div>

  <!-- Interactive Floating Tooltip -->
  <div
    id="gh-tooltip"
    class="pointer-events-none fixed z-[9999] opacity-0 transition-opacity duration-150 -translate-x-1/2 -translate-y-full rounded-lg border border-white/20 bg-[#070b0e]/95 px-3 py-1.5 font-mono text-[11px] text-white shadow-2xl backdrop-blur-md whitespace-nowrap"
    role="tooltip"
    style="top: 0; left: 0;"
  >
    <div id="gh-tooltip-text" class="flex items-center gap-1.5 leading-none">0 contributions</div>
    <div class="absolute left-1/2 top-full -translate-x-1/2 -mt-[1px] border-4 border-transparent border-t-[#070b0e]"></div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const gridContainer = document.getElementById("gh-grid");
    const totalCountEl = document.getElementById("gh-total-count");
    const selectedYearEl = document.getElementById("gh-selected-year");
    const yearTabs = document.querySelectorAll(".gh-year-btn");
    const tooltip = document.getElementById("gh-tooltip");
    const tooltipText = document.getElementById("gh-tooltip-text");

    if (!gridContainer) return;

    // Ensure tooltip is attached to document.body so position:fixed is relative to window viewport
    if (tooltip && tooltip.parentElement !== document.body) {
      document.body.appendChild(tooltip);
    }

    const allContributions = JSON.parse(gridContainer.dataset.allContributions || "{}");
    const allTotals = JSON.parse(gridContainer.dataset.allTotals || "{}");

    // Format date string to "Aug 29, 2026"
    function formatDate(dateStr: string) {
      if (!dateStr) return "";
      const [y, m, d] = dateStr.split("-").map(Number);
      const date = new Date(Date.UTC(y, m - 1, d));
      return date.toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
        timeZone: "UTC",
      });
    }

    // Attach Tooltip handlers to all cells
    function attachCellEvents() {
      const cells = gridContainer?.querySelectorAll(".gh-cell");
      cells?.forEach((cell) => {
        const count = cell.getAttribute("data-count");
        const dateStr = cell.getAttribute("data-date");
        if (!dateStr) return;

        cell.addEventListener("mouseenter", (e) => {
          if (!tooltip || !tooltipText) return;
          const formatted = formatDate(dateStr);
          const countNum = Number(count || 0);
          const unit = countNum === 1 ? "contribution" : "contributions";
          tooltipText.innerHTML = `<span class="text-mint font-bold">${countNum}</span> <span class="text-gray-200">${unit}</span> on <span class="text-white font-semibold">${formatted}</span>`;
          
          const rect = (e.target as HTMLElement).getBoundingClientRect();
          const targetX = rect.left + rect.width / 2;
          const targetY = rect.top - 8;

          tooltip.style.left = `${targetX}px`;
          tooltip.style.top = `${targetY}px`;
          tooltip.classList.remove("opacity-0");
          tooltip.classList.add("opacity-100");
        });

        cell.addEventListener("mouseleave", () => {
          if (!tooltip) return;
          tooltip.classList.remove("opacity-100");
          tooltip.classList.add("opacity-0");
        });
      });
    }

    // Generate grid HTML for a specific year
    function renderYear(year: string) {
      const days = allContributions[year] || [];
      const total = allTotals[year] ?? 0;

      if (totalCountEl) totalCountEl.textContent = String(total);
      if (selectedYearEl) selectedYearEl.textContent = year;

      const dayMap = new Map<string, { count: number; level: number }>();
      days.forEach((d: { date: string; count: number; level: number }) => dayMap.set(d.date, d));

      const startDate = new Date(`${year}-01-01T00:00:00Z`);
      const endDate = new Date(`${year}-12-31T23:59:59Z`);
      const startDayOfWeek = startDate.getUTCDay();
      const gridStart = new Date(startDate);
      gridStart.setUTCDate(startDate.getUTCDate() - startDayOfWeek);

      const curr = new Date(gridStart);
      let html = "";

      while (curr <= endDate || curr.getUTCDay() !== 0) {
        html += `<div class="flex flex-col gap-[3px] sm:gap-1 flex-1">`;
        for (let i = 0; i < 7; i++) {
          const dateStr = curr.toISOString().split("T")[0];
          const inYear = curr.getUTCFullYear() === Number(year);
          const dayData = dayMap.get(dateStr);
          const count = dayData ? dayData.count : 0;
          const level = dayData ? dayData.level : 0;

          if (inYear) {
            html += `<div 
              class="gh-cell gh-cell-${level} aspect-square w-full rounded-[2.5px] sm:rounded-[3px] transition-all duration-200 hover:scale-125 hover:z-30 cursor-pointer" 
              data-date="${dateStr}" 
              data-count="${count}" 
              data-level="${level}"
            ></div>`;
          } else {
            html += `<div class="gh-cell aspect-square w-full opacity-0 pointer-events-none"></div>`;
          }
          curr.setUTCDate(curr.getUTCDate() + 1);
        }
        html += `</div>`;
      }

      if (gridContainer) {
        gridContainer.innerHTML = html;
        attachCellEvents();
      }
    }

    // Switch active year tab styling
    yearTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const year = tab.getAttribute("data-year");
        if (!year) return;

        yearTabs.forEach((t) => {
          t.classList.remove("bg-mint", "text-[#07100d]", "font-bold", "shadow-sm");
          t.classList.add("text-muted");
          t.setAttribute("aria-selected", "false");
        });

        tab.classList.remove("text-muted");
        tab.classList.add("bg-mint", "text-[#07100d]", "font-bold", "shadow-sm");
        tab.setAttribute("aria-selected", "true");

        renderYear(year);
      });
    });

    // Initial tooltip event binding
    attachCellEvents();
  });
</script>
