---
import GithubContributions from "@/components/GithubContributions.astro";
---

<!-- GitHub Activity Section (Directly Below Landing/Hero) -->
<section id="activity" class="page-shell pt-8 pb-14 sm:pt-10 sm:pb-16 lg:pt-12 lg:pb-20">
  <div class="mb-8 max-w-3xl scroll-reveal">
    <h2 class="font-display text-3xl font-extrabold leading-tight text-ink sm:text-4xl">
      GitHub Activity
    </h2>
    <p class="mt-2.5 max-w-2xl text-sm leading-relaxed text-muted">
      Public commits, repository contributions, and daily development cadence.
    </p>
  </div>
  <GithubContributions />
</section>
