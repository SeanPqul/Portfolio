---
import { ExternalLink, FileText, Mail } from "@lucide/astro";
import { cvHref } from "@/data/site";
---

<!-- Contact Section -->
<section id="contact" class="page-shell fluid-section overflow-hidden">
  <div class="glass relative grid gap-8 sm:gap-10 overflow-hidden rounded-2xl border border-white/8 p-4 transition-all hover:border-white/12 sm:p-7 md:grid-cols-[1.1fr_0.9fr] md:p-10">
    <!-- Glow background -->
    <span class="absolute -left-16 -top-16 size-48 bg-amber/5 rounded-full blur-3xl pointer-events-none"></span>

    <div class="scroll-reveal">
      <p class="section-kicker">Get In Touch</p>
      <h2 class="mt-3 font-display text-3xl font-extrabold leading-tight text-ink sm:text-4xl">
        Let's build something practical together.
      </h2>
      <p class="mt-5 text-sm leading-relaxed text-muted">
        I am open to junior full-stack, frontend, backend, or mobile developer roles, with availability for remote or hybrid positions.
      </p>

      <div class="mt-8 max-w-lg border-t border-white/8 pt-5">
        <p class="text-[10px] font-extrabold uppercase tracking-[0.16em] text-muted">Current Focus</p>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          Building practical web dashboards, backend APIs, and mobile workflows with Laravel, React, and React Native.
        </p>
      </div>
    </div>

    <!-- Contact Options -->
    <div class="scroll-reveal flex flex-col justify-between rounded-2xl border border-white/6 bg-white/[0.02] p-4 sm:p-5 md:p-6" style="transition-delay: 150ms;">
      <div>
        <p class="text-[10px] font-extrabold uppercase tracking-[0.16em] text-mint">Preferred Contact</p>
        <h3 class="mt-3 font-display text-2xl font-extrabold leading-tight text-ink">
          Reach out directly.
        </h3>
        <p class="mt-4 text-sm leading-relaxed text-muted">
          For recruiter messages, collaboration, or project questions, send a direct email and I will reply when available.
        </p>
      </div>

      <div class="mt-8 space-y-3">
        <a
          href="mailto:seanpaullapasanda@gmail.com?subject=Portfolio%20Opportunity"
          class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-full bg-mint px-5 py-3 text-sm font-extrabold text-[#07100d] transition hover:-translate-y-0.5 hover:bg-[#7af0c8] hover:shadow-lg hover:shadow-mint/20"
        >
          <Mail size={18} />
          Send Email
        </a>

        <div class="grid gap-3 sm:grid-cols-2">
          <a
            href="https://www.linkedin.com/in/sean-paul-lapasanda-219117241/"
            target="_blank"
            rel="noreferrer"
            class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full border border-white/8 bg-[#0b0f14]/40 px-4 py-2.5 text-xs font-bold text-ink transition hover:border-sky hover:text-sky"
          >
            <ExternalLink size={15} />
            LinkedIn
          </a>
          <a
            href={cvHref}
            target="_blank"
            rel="noreferrer"
            class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full border border-white/8 bg-[#0b0f14]/40 px-4 py-2.5 text-xs font-bold text-ink transition hover:border-amber hover:text-amber"
          >
            <FileText size={15} />
            View CV
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
