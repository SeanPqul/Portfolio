---
import { profileLinks } from "@/data/site";
---

<footer class="border-t border-white/8 bg-bg-deep/70 py-7 overflow-hidden">
  <div class="page-shell flex flex-col justify-between gap-3 text-xs text-muted sm:flex-row sm:items-center">
    <p>&copy; 2026 Sean Paul S. Lapasanda. All rights reserved.</p>
    <div class="flex flex-wrap gap-x-4 gap-y-2 font-bold">
      {
        profileLinks.map((link) => (
          <a
            href={link.href}
            id={`${link.id}-footer`}
            target={link.href.startsWith("mailto:") ? undefined : "_blank"}
            rel={link.href.startsWith("mailto:") ? undefined : "noreferrer"}
            class="transition hover:text-ink"
          >
            {link.label}
          </a>
        ))
      }
      <a href="#top" class="transition hover:text-ink">Back to top</a>
    </div>
  </div>
</footer>
