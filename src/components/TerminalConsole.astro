---
import { Terminal } from "@lucide/astro";
import yuukoImage from "../assets/yuuko.jpg?url";
import yuukoImageTwo from "../assets/yuuko-2.jpg?url";
import yuukoImageThree from "../assets/yuuko-3.jpg?url";
---

<div
  id="terminal-console"
  data-yuuko-image={yuukoImage}
  data-yuuko-image-two={yuukoImageTwo}
  data-yuuko-image-three={yuukoImageThree}
  class="terminal-console flex-1 flex w-full min-w-0 flex-col overflow-hidden font-mono text-xs sm:text-sm"
>
  <!-- Terminal Output/Input Area -->
  <div id="terminal-body" class="flex-1 space-y-2 overflow-y-auto p-3 select-text scrollbar-thin scrollbar-thumb-white/10 sm:p-4">
    <div id="terminal-last-login" class="text-muted text-xs">Loading session...</div>
    <div class="text-muted/90">Welcome to Bash v5.2 (x86_64-pc-linux-gnu)</div>
    <div class="text-muted">Type <span class="text-amber">help</span> to list available commands.</div>
    <div class="h-1"></div>

    <!-- Commands History -->
    <div id="terminal-history" class="space-y-2"></div>

    <!-- Input Line -->
    <div class="flex items-center gap-2">
      <span class="shrink-0 text-[11px] text-mint sm:text-sm">ichihara@bash:~$</span>
      <div class="relative min-w-0 flex-1">
        <input 
          type="text" 
          id="terminal-input" 
          class="w-full border-none bg-transparent p-0 text-ink outline-none focus:ring-0" 
          autocomplete="off" 
          autocorrect="off" 
          autocapitalize="off" 
          spellcheck="false" 
          maxlength="50"
          aria-label="Terminal CLI input"
        />
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const pageLoadTime = Date.now();
    // Calculate dynamic Last login timestamp (simulates a previous session 2h 14m ago)
    const lastLogin = document.getElementById("terminal-last-login");
    if (lastLogin) {
      const now = new Date();
      const lastSession = new Date(now.getTime() - (2 * 60 + 14) * 60 * 1000);
      const dateOptions: Intl.DateTimeFormatOptions = { weekday: 'short', month: 'short', day: 'numeric' };
      const timeOptions: Intl.DateTimeFormatOptions = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
      
      const dateStr = lastSession.toLocaleDateString('en-US', dateOptions);
      const timeStr = lastSession.toLocaleTimeString('en-US', timeOptions);
      lastLogin.textContent = `Last login: ${dateStr} ${timeStr} on ttys000`;
    }

    const terminalBody = document.getElementById("terminal-body");
    const terminalConsole = document.getElementById("terminal-console");
    const terminalInput = document.getElementById("terminal-input") as HTMLInputElement;
    const terminalHistory = document.getElementById("terminal-history");

    if (!terminalInput || !terminalHistory || !terminalBody) return;

    const yuukoImage = terminalConsole?.dataset.yuukoImage || "";
    const yuukoImageTwo = terminalConsole?.dataset.yuukoImageTwo || "";
    const yuukoImageThree = terminalConsole?.dataset.yuukoImageThree || "";

    // Track whether user has manually scrolled up — if so, don't force-scroll on new output
    let userScrolledUp = false;
    terminalBody.addEventListener("scroll", () => {
      const distanceFromBottom = terminalBody.scrollHeight - terminalBody.scrollTop - terminalBody.clientHeight;
      userScrolledUp = distanceFromBottom > 80;
    });

    // Focus input on terminal area click — preventScroll so we don't jump down
    terminalBody.addEventListener("click", () => {
      terminalInput.focus({ preventScroll: true });
    });

    // Scroll to bottom only when the user actually starts typing
    terminalInput.addEventListener("keydown", (e) => {
      const isTypingKey = e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey;
      const isBackspace = e.key === "Backspace";
      if ((isTypingKey || isBackspace) && userScrolledUp) {
        userScrolledUp = false;
        terminalBody.scrollTop = terminalBody.scrollHeight;
      }
    });

    const commands: Record<string, string> = {
      help: `Available commands:<br>
  - <span class="text-amber">about</span>      : Learn more about Sean Paul<br>
  - <span class="text-amber">projects</span>   : Showcase of key web and mobile systems<br>
  - <span class="text-amber">skills</span>     : List technical stacks used<br>
  - <span class="text-amber">anime</span>      : See my early custom CSS project on MyAnimeList<br>
  - <span class="text-amber">contact</span>    : Find links to get in touch<br>
  - <span class="text-amber">clear</span>      : Clear the terminal console screen`,
      about: `I'm Sean Paul S. Lapasanda, a Full-Stack Developer focused on building web applications, workflow tools, APIs, and mobile features.
  I work with Laravel, React, and React Native to connect clean interfaces with database-backed functionality, while continuing to learn and adapt to new technologies.`,
      projects: `Featured projects:<br><br>
  1. <span class="text-amber font-bold">MorataFMS</span>: Web application built with Laravel and React for brokerage/legal workflows, import/export transaction tracking, document handling, and role-based access.<br>
  2. <span class="text-amber font-bold">EMEDICARD</span>: Mobile application built with React Native and Convex to verify member health credentials using a QR code scanner.`,
      skills: `<span class="text-sky font-bold">Frontend:</span> React, TypeScript, HTML, Tailwind CSS, Next.js, Nuxt.js, Vue.js, Astro<br>
  <span class="text-sky font-bold">Backend:</span> Laravel, PHP, Python, FastAPI, Node.js, TypeScript, PostgreSQL, MySQL, Convex DB, Clerk<br>
  <span class="text-sky font-bold">Cloud & DevOps:</span> Docker, Cloudflare, Amazon S3, Vercel, Railway<br>
  <span class="text-sky font-bold">Mobile:</span> React Native, Expo, Expo Router<br>
  <span class="text-sky font-bold">AI Agents:</span> Codex, Claude Code, Antigravity`,
      contact: `Let's connect! You can reach me via:<br>
  - <span class="text-sky font-bold">Email:</span> <a href="mailto:seanpaullapasanda@gmail.com" class="text-amber hover:underline">seanpaullapasanda@gmail.com</a><br>
  - <span class="text-sky font-bold">GitHub:</span> <a href="https://github.com/SeanPqul" target="_blank" class="text-amber hover:underline">https://github.com/SeanPqul</a><br>
  - <span class="text-sky font-bold">LinkedIn:</span> <a href="https://www.linkedin.com/in/sean-paul-lapasanda-219117241/" target="_blank" class="text-amber hover:underline">LinkedIn Profile</a>`,
    };

    const cmdHistory: string[] = [];
    let historyIndex = 0;

    terminalInput.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        const fullValue = terminalInput.value.trim();
        const cmd = fullValue.toLowerCase();
        const parts = fullValue.split(/\s+/);
        
        if (!fullValue) return;

        // Push to history
        if (cmdHistory.length === 0 || cmdHistory[cmdHistory.length - 1] !== fullValue) {
          cmdHistory.push(fullValue);
        }
        historyIndex = cmdHistory.length;

        // Print input in history
        const inputLine = document.createElement("div");
        inputLine.innerHTML = `<span class="text-mint">ichihara@bash:~$</span> <span class="text-ink">${fullValue}</span>`;
        terminalHistory.appendChild(inputLine);

        // Process command
        const outputLine = document.createElement("div");
        outputLine.className = "pl-2 text-muted leading-relaxed text-xs";

        if (cmd === "clear") {
          terminalHistory.innerHTML = "";
          terminalInput.value = "";
          return;
        } else if (cmd === "exit" || cmd === "profile" || cmd === "gui" || cmd === "close" || cmd === "camera") {
          const closeBtn = document.getElementById("window-dot-close");
          if (closeBtn) {
            closeBtn.click();
            terminalInput.value = "";
            return;
          }
        } else if (cmd === "sudo") {
          outputLine.innerHTML = `<span class="text-[#ff5f56] font-bold">Permission denied:</span> Sean did not give you root access. Try regular commands instead.`;
        } else if (parts[0].toLowerCase() === "cat") {
          const arg = parts.slice(1).join(" ").toLowerCase().replace(/\.txt$/, "").trim();
          if (!arg) {
            outputLine.innerHTML = `
<div class="flex items-center gap-4 font-mono text-[11px] md:text-xs select-none py-1 leading-relaxed">
  <pre class="text-[#f6c56f] font-bold leading-tight select-none">
 /\\_/\\
( o.o )
 > ^ <
  </pre>
  <div>
    <span class="text-mint font-bold text-sm">Meow!</span> I am the system cat.<br>
    Usage: <span class="text-amber">cat [file]</span> (e.g., <span class="text-amber">cat about.txt</span>, <span class="text-amber">cat projects.txt</span>)
  </div>
</div>`;
          } else if (arg === "about" || arg === "projects" || arg === "skills" || arg === "contact") {
            outputLine.innerHTML = commands[arg];
          } else if (arg === "mcdonalds" || arg === "mcdo") {
            outputLine.innerHTML = `🍟 <span class="text-amber font-bold">Crew Trainer (2022 - 2026):</span> Worked part-time kitchen shifts and trained new team members while balancing academic studies. Developed communication, teamwork, and operational discipline.`;
          } else if (arg === "anime" || arg === "mal" || arg === "myanimelist") {
            outputLine.innerHTML = `🌸 <span class="text-[#a78bfa] font-bold">MyAnimeList CSS Customization (2022):</span> Forked a GitHub repository and customized its CSS stylesheets to design a custom dark, glassmorphic layout for my list. View it here: <a href="https://myanimelist.net/animelist/madfaker?status=2" target="_blank" class="text-mint hover:underline">https://myanimelist.net/animelist/madfaker</a>`;
          } else if (arg === "neofetch") {
            outputLine.innerHTML = `cat: neofetch: Cannot open binary file`;
          } else {
            outputLine.innerHTML = `cat: ${parts.slice(1).join(" ")}: No such file or directory`;
          }
        } else if (cmd === "neofetch") {
          const uptimeMs = Date.now() - pageLoadTime;
          const uptimeSec = Math.floor(uptimeMs / 1000);
          const uptimeMin = Math.floor(uptimeSec / 60);
          const uptimeStr = uptimeMin > 0 
            ? `${uptimeMin}m ${uptimeSec % 60}s` 
            : `${uptimeSec}s`;

          outputLine.innerHTML = `
<div class="flex items-start gap-4 font-mono text-[11px] md:text-xs select-none py-1 leading-relaxed">
  <div class="hidden sm:block shrink-0 size-32 overflow-hidden rounded-lg border border-white/10 bg-bg-deep select-none cursor-pointer hover:opacity-90 active:scale-95 transition-all">
    <img src="${yuukoImageThree}" alt="Ichihara Yuuko" class="size-full object-cover" data-yuuko-cycle="true" data-yuuko-index="0" />
  </div>
  <div class="space-y-0.5">
    <div class="text-amber font-bold">ichihara@bash</div>
    <div class="text-muted/40">-------------</div>
    <div><span class="text-sky font-bold">OS:</span> Arch Linux x86_64</div>
    <div><span class="text-sky font-bold">Host:</span> Portfolio Web App</div>
    <div><span class="text-sky font-bold">Kernel:</span> Astro 4.15 + Tailwind 4.0</div>
    <div><span class="text-sky font-bold">Uptime:</span> ${uptimeStr}</div>
    <div><span class="text-sky font-bold">Shell:</span> bash 5.2.15</div>
    <div><span class="text-sky font-bold">Resolution:</span> ${window.innerWidth}x${window.innerHeight}</div>
    <div><span class="text-sky font-bold">DE:</span> Glassmorphic CSS</div>
    <div><span class="text-sky font-bold">WM:</span> DeveloperDeck.astro</div>
    <div><span class="text-sky font-bold">Terminal:</span> AstroConsole CLI</div>
    <div><span class="text-sky font-bold">CPU:</span> Coffee-fueled BSIT Core (4.0GHz)</div>
    <div><span class="text-sky font-bold">Memory:</span> 16GB Dedicated / 100% Passion</div>
  </div>
</div>`;
        } else if (cmd in commands) {
          outputLine.innerHTML = commands[cmd];
        } else if (cmd === "mcdonalds" || cmd === "mcdo") {
          outputLine.innerHTML = `🍟 <span class="text-amber font-bold">Crew Trainer (2022 - 2026):</span> Worked part-time kitchen shifts and trained new team members while balancing academic studies. Developed communication, teamwork, and operational discipline.`;
        } else if (cmd === "anime" || cmd === "mal" || cmd === "myanimelist") {
          outputLine.innerHTML = `🌸 <span class="text-[#a78bfa] font-bold">MyAnimeList CSS Customization (2022):</span> Forked a GitHub repository and customized its CSS stylesheets to design a custom dark, glassmorphic layout for my list. View it here: <a href="https://myanimelist.net/animelist/madfaker?status=2" target="_blank" class="text-mint hover:underline">https://myanimelist.net/animelist/madfaker</a>`;
        } else {
          outputLine.innerHTML = `bash: command not found: <span class="text-[#ff5f56]">${fullValue}</span>. Type <span class="text-amber">help</span> to view commands.`;
        }

        terminalHistory.appendChild(outputLine);
        const cycleImage = outputLine.querySelector("[data-yuuko-cycle]") as HTMLImageElement | null;
        if (cycleImage) {
          const cycleImages = [yuukoImageThree, yuukoImage, yuukoImageTwo].filter(Boolean);
          cycleImage.addEventListener("click", () => {
            const currentIndex = Number(cycleImage.dataset.yuukoIndex || "0");
            const nextIndex = (currentIndex + 1) % cycleImages.length;
            cycleImage.dataset.yuukoIndex = String(nextIndex);
            cycleImage.src = cycleImages[nextIndex];
          });
        }
        terminalInput.value = "";
        
        // Auto-scroll to bottom only if the user hasn't scrolled up to read/copy
        if (!userScrolledUp) {
          setTimeout(() => {
            terminalBody.scrollTop = terminalBody.scrollHeight;
          }, 10);
        }
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        if (cmdHistory.length > 0) {
          if (historyIndex > 0) {
            historyIndex--;
            terminalInput.value = cmdHistory[historyIndex];
          } else if (historyIndex === -1 || historyIndex === cmdHistory.length) {
            historyIndex = cmdHistory.length - 1;
            terminalInput.value = cmdHistory[historyIndex];
          }
        }
      } else if (e.key === "ArrowDown") {
        e.preventDefault();
        if (cmdHistory.length > 0) {
          if (historyIndex < cmdHistory.length - 1 && historyIndex >= 0) {
            historyIndex++;
            terminalInput.value = cmdHistory[historyIndex];
          } else if (historyIndex === cmdHistory.length - 1) {
            historyIndex = cmdHistory.length;
            terminalInput.value = "";
          }
        }
      }
    });
  });
</script>
