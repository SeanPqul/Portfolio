---
import type { TimelineItem } from "@/data/timeline";

interface Props {
  item: TimelineItem;
}

const { item } = Astro.props;
---

<article class={`scroll-reveal glass rounded-2xl border border-white/8 p-4 sm:p-5 ${item.borderColor} hover:-translate-y-0.5 transition-all duration-300 relative overflow-hidden group/card flex flex-col justify-between`}>
  <span class={`absolute -right-8 -top-8 size-20 ${item.glowColor} rounded-full blur-xl ${item.innerGlowColor} transition-all duration-300 pointer-events-none`}></span>

  <div>
    <!-- Header -->
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex min-w-0 items-center gap-3">
        <span class={`grid size-9 place-items-center rounded-xl bg-white/[0.03] border border-white/8 ${item.accentColor}`}>
          <item.icon size={18} />
        </span>
        <span class="text-[9px] font-mono font-bold tracking-widest text-muted uppercase">
          {item.tag}
        </span>
      </div>
      <span class="w-fit rounded-full border border-white/5 bg-white/5 px-2 py-0.5 font-mono text-[9px] text-muted">
        {item.date}
      </span>
    </div>

    <!-- Title & Company -->
    <div class="mt-3.5 text-left">
      <h3 class={`text-base font-bold font-display transition-colors group-hover/card:${item.accentColor} ${item.highlight ? item.accentColor : "text-ink"}`}>
        {item.role}
      </h3>
      <p class="text-xs text-muted font-medium mt-1">{item.company}</p>
    </div>

    <!-- Bullets -->
    <ul class="mt-4 space-y-2.5 text-xs text-muted list-none leading-relaxed text-left">
      {
        item.bullets.map((bullet) => (
          <li class={`relative pl-4 before:absolute before:left-0 before:top-2 before:size-1.5 before:rounded-full ${item.dotColor}`}>
            {bullet}
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Tech Tags -->
  {
    item.techTags && item.techTags.length > 0 && (
      <div class="mt-5 flex flex-wrap gap-1 justify-start">
        {
          item.techTags.map((tech) => (
            <span class="rounded bg-white/4 border border-white/5 px-2 py-0.5 text-[10px] font-medium text-muted transition-colors group-hover/card:border-current group-hover/card:text-ink">
              {tech}
            </span>
          ))
        }
      </div>
    )
  }
</article>
