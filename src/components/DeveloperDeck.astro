---
import FloatingStatsCard from "./FloatingStatsCard.astro";
import TerminalConsole from "./TerminalConsole.astro";
---

<div class="group/deck relative flex w-full min-w-0 flex-col gap-3 overflow-visible">
  <!-- Unified Window Container (Starts with glass terminal styles as default) -->
  <div 
    id="deck-window" 
    class="glass flex w-full flex-col rounded-2xl relative transition-all duration-500 overflow-hidden border border-white/10 shadow-2xl bg-bg-card"
  >
    
    <!-- Unified Window Header Bar (Visible by default for Terminal) -->
    <div 
      id="deck-window-header" 
      class="flex items-center justify-between border-b border-white/10 px-4 py-3 select-none transition-all duration-500"
    >
      <!-- macOS-style window controls -->
      <div 
        id="deck-window-dots" 
        class="flex items-center gap-2 transition-opacity duration-500"
      >
        <span id="window-dot-close" class="size-3 rounded-full bg-[#ff5f56] opacity-80 hover:opacity-100 cursor-pointer transition-opacity" title="Close Terminal & show profile"></span>
        <span class="size-3 rounded-full bg-[#ffbd2e] opacity-80 hover:opacity-100 transition-opacity"></span>
        <span class="size-3 rounded-full bg-[#27c93f] opacity-80 hover:opacity-100 transition-opacity"></span>
      </div>
      
      <!-- Spacer for centering header items -->
      <div class="w-1"></div>


    </div>

    <!-- Content Pane Area -->
    <div class="relative flex w-full min-w-0 flex-1 flex-col">
      <!-- Profile Card Tab Pane (Hidden by default) -->
      <div id="deck-pane-profile" class="hidden w-full flex-1">
        <FloatingStatsCard />
      </div>

      <!-- Terminal Console Tab Pane (Visible by default) -->
      <div id="deck-pane-terminal" class="flex h-[min(460px,70svh)] w-full min-w-0 flex-col sm:h-[480px] lg:h-[510px]">
        <TerminalConsole />
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const paneProfile = document.getElementById("deck-pane-profile");
    const paneTerminal = document.getElementById("deck-pane-terminal");
    
    const deckWindow = document.getElementById("deck-window");
    const windowHeader = document.getElementById("deck-window-header");
    const windowDots = document.getElementById("deck-window-dots");
    const windowDotClose = document.getElementById("window-dot-close");

    // References to the Hero CLI Toggle button on the left column of the page
    const heroCliToggle = document.getElementById("hero-cli-toggle");
    const heroCliIconTerminal = document.getElementById("hero-cli-icon-terminal");
    const heroCliIconProfile = document.getElementById("hero-cli-icon-profile");
    const heroCliText = document.getElementById("hero-cli-text");

    if (!paneProfile || !paneTerminal) return;

    const profilePane = paneProfile;
    const terminalPane = paneTerminal;

    let currentMode = "terminal";

    // A. Switch to Profile View
    function showProfile() {
      currentMode = "profile";

      // 1. Toggle panes
      profilePane.classList.remove("hidden");
      terminalPane.classList.add("hidden");

      // 3. Dissolve Window container styles in Profile mode
      if (deckWindow) {
        deckWindow.classList.remove("glass", "border-white/10", "shadow-2xl", "bg-bg-card", "overflow-hidden");
        deckWindow.classList.add("border-transparent", "bg-transparent", "shadow-none", "overflow-visible");
      }
      if (windowHeader) {
        windowHeader.classList.remove("flex", "border-white/10");
        windowHeader.classList.add("hidden", "border-transparent");
      }
      if (windowDots) {
        windowDots.classList.add("opacity-0", "pointer-events-none");
      }

      // 4. Update the Hero CLI Toggle button on the left side
      if (heroCliIconTerminal) heroCliIconTerminal.classList.remove("hidden");
      if (heroCliIconProfile) heroCliIconProfile.classList.add("hidden");
      if (heroCliText) heroCliText.textContent = "Launch CLI";
      if (heroCliToggle) {
        heroCliToggle.classList.remove("border-amber/30", "text-amber");
        heroCliToggle.classList.add("border-white/6", "text-muted");
      }
    }

    // B. Switch to Terminal View
    function showTerminal() {
      currentMode = "terminal";

      // 1. Toggle panes
      terminalPane.classList.remove("hidden");
      profilePane.classList.add("hidden");

      // 3. Restore Window wrapper (borders, glass background, shadow) in Terminal mode
      if (deckWindow) {
        deckWindow.classList.remove("border-transparent", "bg-transparent", "shadow-none", "overflow-visible");
        deckWindow.classList.add("glass", "border-white/10", "shadow-2xl", "bg-bg-card", "overflow-hidden");
      }
      if (windowHeader) {
        windowHeader.classList.remove("hidden", "border-transparent");
        windowHeader.classList.add("flex", "border-white/10");
      }
      if (windowDots) {
        windowDots.classList.remove("opacity-0", "pointer-events-none");
      }

      // 4. Update the Hero CLI Toggle button on the left side
      if (heroCliIconTerminal) heroCliIconTerminal.classList.add("hidden");
      if (heroCliIconProfile) heroCliIconProfile.classList.remove("hidden");
      if (heroCliText) heroCliText.textContent = "Close CLI";
      if (heroCliToggle) {
        heroCliToggle.classList.remove("border-white/6", "text-muted");
        heroCliToggle.classList.add("border-amber/30", "text-amber");
      }

      // Focus input automatically inside terminal when opened
      const termInput = document.getElementById("terminal-input") as HTMLInputElement;
      if (termInput) {
        setTimeout(() => termInput.focus(), 50);
      }
    }

    // C. Event Listeners
    // Toggle when clicking the hero social row toggle button
    heroCliToggle?.addEventListener("click", () => {
      if (currentMode === "profile") {
        showTerminal();
      } else {
        showProfile();
      }
    });

    // Close when clicking the macOS window red dot
    windowDotClose?.addEventListener("click", () => {
      showProfile();
    });
  });
</script>
