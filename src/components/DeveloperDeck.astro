---
import TerminalConsole from "./TerminalConsole.astro";
---

<div class="group/deck relative flex w-full min-w-0 max-w-full flex-col gap-3">
  <!-- Terminal Window Container -->
  <div 
    id="deck-window" 
    class="glass flex h-[420px] sm:h-[480px] lg:h-[520px] w-full flex-col rounded-2xl relative overflow-hidden border border-white/10 shadow-2xl bg-bg-card"
  >
    <!-- Window Header Bar -->
    <div 
      id="deck-window-header" 
      class="flex h-11 shrink-0 items-center justify-between border-b border-white/10 px-4 select-none"
    >
      <!-- macOS-style window controls -->
      <div 
        id="deck-window-dots" 
        class="flex items-center gap-2"
      >
        <span id="window-dot-close" class="size-3 rounded-full bg-[#ff5f56] opacity-80 hover:opacity-100 cursor-pointer transition-opacity" title="Clear terminal"></span>
        <span class="size-3 rounded-full bg-[#ffbd2e] opacity-80 hover:opacity-100 transition-opacity"></span>
        <span class="size-3 rounded-full bg-[#27c93f] opacity-80 hover:opacity-100 transition-opacity"></span>
      </div>
      
      <!-- Terminal title label -->
      <div class="text-[11px] font-mono text-muted/60 tracking-wider">ichihara@bash:~</div>

      <!-- Spacer for centering -->
      <div class="w-10"></div>
    </div>

    <!-- Terminal Console Pane -->
    <div class="relative flex w-full min-w-0 flex-1 min-h-0 flex-col overflow-hidden">
      <TerminalConsole />
    </div>
  </div>
</div>
