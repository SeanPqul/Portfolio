---
import FloatingStatsCard from "./FloatingStatsCard.astro";
import TerminalConsole from "./TerminalConsole.astro";
import { Terminal, User } from "@lucide/astro";
---

<div class="w-full flex flex-col gap-3 group/deck">
  <!-- Tab Switcher Bar -->
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-1.5 bg-white/[0.03] border border-white/6 p-1 rounded-full select-none">
      <!-- Profile Tab Button -->
      <button 
        id="deck-tab-profile" 
        class="flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-bold font-display cursor-pointer transition-all duration-300 bg-mint text-bg-deep font-extrabold shadow-sm"
        aria-label="Switch to profile card view"
      >
        <User size={13} class="shrink-0" />
        <span>Profile Card</span>
      </button>

      <!-- Terminal Tab Button -->
      <button 
        id="deck-tab-terminal" 
        class="flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-medium font-display cursor-pointer transition-all duration-300 text-muted hover:text-ink"
        aria-label="Switch to CLI terminal console"
      >
        <Terminal size={13} class="shrink-0" />
        <span>Terminal CLI</span>
      </button>
    </div>
  </div>

  <!-- Content Deck (Wrapper) -->
  <div class="relative w-full">
    <!-- Profile Card Tab Pane -->
    <div id="deck-pane-profile" class="block transition-all duration-300">
      <FloatingStatsCard />
    </div>

    <!-- Terminal Console Tab Pane -->
    <div id="deck-pane-terminal" class="hidden transition-all duration-300">
      <TerminalConsole />
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const tabProfile = document.getElementById("deck-tab-profile");
    const tabTerminal = document.getElementById("deck-tab-terminal");
    const paneProfile = document.getElementById("deck-pane-profile");
    const paneTerminal = document.getElementById("deck-pane-terminal");
    const statusDot = document.getElementById("deck-status-dot");
    const statusText = document.getElementById("deck-status-text");

    if (!tabProfile || !tabTerminal || !paneProfile || !paneTerminal) return;

    // A. Switch to Profile View
    function showProfile() {
      // 1. Update button styling
      tabProfile?.classList.add("bg-mint", "text-bg-deep", "font-extrabold");
      tabProfile?.classList.remove("text-muted", "font-medium");
      
      tabTerminal?.classList.remove("bg-mint", "text-bg-deep", "font-extrabold");
      tabTerminal?.classList.add("text-muted", "font-medium");

      // 2. Toggle panes
      paneProfile?.classList.remove("hidden");
      paneProfile?.classList.add("block");
      
      paneTerminal?.classList.remove("block");
      paneTerminal?.classList.add("hidden");

      // 3. Update status text
      if (statusDot) statusDot.style.backgroundColor = "var(--color-mint)";
      if (statusText) statusText.textContent = "Profile Active";
    }

    // B. Switch to Terminal View
    function showTerminal() {
      // 1. Update button styling
      tabTerminal?.classList.add("bg-mint", "text-bg-deep", "font-extrabold");
      tabTerminal?.classList.remove("text-muted", "font-medium");
      
      tabProfile?.classList.remove("bg-mint", "text-bg-deep", "font-extrabold");
      tabProfile?.classList.add("text-muted", "font-medium");

      // 2. Toggle panes
      paneTerminal?.classList.remove("hidden");
      paneTerminal?.classList.add("block");
      
      paneProfile?.classList.remove("block");
      paneProfile?.classList.add("hidden");

      // 3. Update status text
      if (statusDot) statusDot.style.backgroundColor = "var(--color-amber)";
      if (statusText) statusText.textContent = "Console Shell";

      // Focus input automatically inside terminal when opened
      const termInput = document.getElementById("terminal-input") as HTMLInputElement;
      if (termInput) {
        setTimeout(() => termInput.focus(), 50);
      }
    }

    // C. Event Listeners
    tabProfile.addEventListener("click", showProfile);
    tabTerminal.addEventListener("click", showTerminal);
  });
</script>
