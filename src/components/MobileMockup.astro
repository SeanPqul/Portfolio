---
import { QrCode, Wifi, Battery, CheckCircle2 } from "@lucide/astro";
---

<div class="mockup-card glass relative mx-auto aspect-[22/39] w-full max-w-[220px] select-none rounded-[36px] border-4 border-white/12 bg-bg-card p-2.5 shadow-2xl">
  <!-- Phone Speaker Notch -->
  <div class="absolute top-1.5 left-1/2 -translate-x-1/2 w-16 h-3.5 bg-black rounded-full flex items-center justify-between px-3 z-20">
    <span class="size-1 rounded-full bg-white/20"></span>
    <span class="w-8 h-0.5 bg-white/20 rounded-full"></span>
  </div>

  <!-- Screen Content -->
  <div class="w-full h-full rounded-[28px] bg-[#0c0f12] overflow-hidden flex flex-col font-sans relative border border-white/5">
    
    <!-- Phone Status Bar -->
    <div class="flex items-center justify-between px-4 pt-4 pb-1 text-[8px] text-muted">
      <span>11:15 PM</span>
      <div class="flex items-center gap-1">
        <Wifi size={8} />
        <Battery size={8} />
      </div>
    </div>

    <!-- App Header -->
    <header class="px-3 py-1 flex items-center justify-between border-b border-white/5 bg-white/[0.01]">
      <div class="flex items-center gap-1.5">
        <span class="grid size-4 place-items-center rounded bg-amber text-bg-deep text-[8px] font-bold font-mono">EM</span>
        <span class="text-[9px] font-bold tracking-wider text-amber uppercase">EMEDICARD</span>
      </div>
      <span class="size-1.5 rounded-full bg-mint animate-ping"></span>
    </header>

    <!-- App Screen Body -->
    <main class="flex-1 p-2.5 flex flex-col gap-3 justify-between overflow-y-auto">
      
      <!-- Member ID Card -->
      <div class="rounded-xl bg-gradient-to-br from-bg-card to-white/[0.04] border border-white/10 p-2.5 shadow-md flex flex-col gap-1 relative overflow-hidden">
        <!-- background glows -->
        <span class="absolute -right-4 -top-4 size-10 rounded-full bg-amber/10 blur-md pointer-events-none"></span>
        <div class="flex justify-between items-start">
          <div>
            <div class="text-[6px] text-muted uppercase tracking-wider">Health ID Card</div>
            <div class="text-[10px] font-black text-[#f7f3ea] mt-0.5">Juan Dela Cruz</div>
          </div>
          <span class="rounded bg-mint/10 border border-mint/20 px-1 py-0.2 text-[6px] font-bold text-mint">ACTIVE</span>
        </div>
        <div class="mt-2 flex justify-between items-end">
          <div class="font-mono text-[7px] text-muted">No: EC-2026-9042</div>
          <div class="text-[5px] text-muted leading-tight text-right">Exp: 05/2027</div>
        </div>
      </div>

      <!-- QR Scanner Frame -->
      <div class="flex-1 rounded-xl border border-dashed border-white/15 bg-white/[0.01] p-3 flex flex-col items-center justify-center relative group overflow-hidden">
        <!-- Scanning Box corner lines -->
        <span class="absolute top-1.5 left-1.5 w-2.5 h-2.5 border-t border-l border-mint/60"></span>
        <span class="absolute top-1.5 right-1.5 w-2.5 h-2.5 border-t border-r border-mint/60"></span>
        <span class="absolute bottom-1.5 left-1.5 w-2.5 h-2.5 border-b border-l border-mint/60"></span>
        <span class="absolute bottom-1.5 right-1.5 w-2.5 h-2.5 border-b border-r border-mint/60"></span>

        <!-- Scan line animation -->
        <div class="absolute left-0 w-full h-[1.5px] bg-mint shadow-[0_0_8px_rgba(102,224,181,0.8)] z-10 animate-[scan_2.5s_ease-in-out_infinite]"></div>

        <!-- Custom Styling for scan keyframe inline since it is unique -->
        <style>
          @keyframes scan {
            0%, 100% { top: 10%; }
            50% { top: 90%; }
          }
        </style>

        <!-- QR Code Graphic -->
        <div class="size-16 bg-white p-1 rounded-md flex items-center justify-center shadow-inner relative z-0">
          <QrCode class="text-black size-14" />
        </div>
        <span class="text-[7px] text-muted mt-2 tracking-wide uppercase">Align QR Code inside frame</span>
      </div>

      <!-- Live Inspector Feedback Banner -->
      <div class="rounded-lg bg-mint/5 border border-mint/15 p-1.5 flex items-center gap-2">
        <CheckCircle2 size={12} class="text-mint shrink-0" />
        <div class="truncate">
          <p class="text-[7px] font-bold text-mint leading-none">VERIFIED</p>
          <p class="text-[6px] text-muted mt-0.5 leading-none">Access granted to Medical Facility</p>
        </div>
      </div>

    </main>

    <!-- Phone Home Bar indicator -->
    <div class="h-4 pb-1.5 flex items-end justify-center shrink-0">
      <span class="w-16 h-1 bg-white/20 rounded-full"></span>
    </div>

  </div>
</div>
