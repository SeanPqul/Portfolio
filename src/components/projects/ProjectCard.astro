---
import { Image } from "astro:assets";
import { ArrowUpRight, Lock } from "@lucide/astro";
import type { Project } from "@/data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article
  class="group scroll-reveal project-card relative flex flex-col justify-between overflow-hidden rounded-2xl bg-bg-deep/55 shadow-xl transition-all duration-300 hover:-translate-y-1.5 hover:shadow-2xl"
  style={project.delay ? `transition-delay: ${project.delay};` : undefined}
>
  <!-- Dedicated border overlay that always paints on top of scaling images -->
  <div class="pointer-events-none absolute inset-0 z-20 rounded-2xl border border-white/10 transition-colors duration-300 group-hover:border-mint/30"></div>
  <div>
    <!-- Visual Screenshot Preview Frame -->
    <div class="aspect-[2.11/1] w-full overflow-hidden border-b border-white/8 bg-[#070b0e] relative">
      <Image
        src={project.image}
        alt={project.imageAlt}
        class:list={[
          "size-full object-cover transition-transform duration-500 group-hover:scale-105",
          project.imagePosition,
        ]}
        loading="lazy"
      />
    </div>

    <!-- Card Body Content -->
    <div class="p-5 sm:p-6">
      <!-- Category Pills -->
      <div class="flex flex-wrap items-center gap-2">
        {
          project.categoryPills.map((pill) => (
            <span class="rounded-full border border-mint/30 bg-mint/5 px-2.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider text-mint">
              {pill}
            </span>
          ))
        }
      </div>

      <!-- Title & Description -->
      <h3 class="mt-3.5 font-display text-xl font-bold text-ink">
        {project.title}
      </h3>
      <p class="mt-2 text-xs sm:text-sm leading-relaxed text-muted">
        {project.description}
      </p>
    </div>
  </div>

  <!-- CTA & Tech Stack -->
  <div class="p-5 pt-0 sm:p-6 sm:pt-0 space-y-3">
    <p class="font-mono text-[10.5px] text-muted/80 truncate">
      {project.stack}
    </p>
    {
      project.cta.type === "locked" && (
        <div
          class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-white/[0.04] border border-white/10 py-2.5 text-xs font-bold text-muted cursor-default select-none shadow-xs"
        >
          <Lock size={13} class="opacity-75 text-mint" />
          <span class="text-ink/90">{project.cta.label}</span>
        </div>
      )
    }
    {
      project.cta.type === "link" && (
        <a
          href={project.cta.href}
          target="_blank"
          rel="noreferrer"
          class="project-card-btn inline-flex w-full items-center justify-center gap-2 rounded-xl bg-white/5 border border-white/10 py-2.5 text-xs font-bold text-ink transition hover:bg-mint hover:text-[#07100d] hover:border-mint shadow-sm"
        >
          <span>{project.cta.label}</span>
          <ArrowUpRight size={14} />
        </a>
      )
    }
    {
      project.cta.type === "modal" && (
        <button
          type="button"
          class="project-card-btn project-modal-trigger inline-flex w-full items-center justify-center gap-2 rounded-xl bg-white/5 border border-white/10 py-2.5 text-xs font-bold text-ink transition hover:bg-mint hover:text-[#07100d] hover:border-mint cursor-pointer shadow-sm"
          data-project-modal-target={project.cta.target}
          aria-haspopup="dialog"
        >
          <span>{project.cta.label}</span>
          <ArrowUpRight size={14} />
        </button>
      )
    }
  </div>
</article>
