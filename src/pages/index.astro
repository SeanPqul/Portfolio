---
import MainLayout from "../layouts/MainLayout.astro";
import DeveloperDeck from "../components/DeveloperDeck.astro";
import McDonaldsIcon from "../components/McDonaldsIcon.astro";
import Logo from "../components/Logo.astro";
import GithubContributions from "../components/GithubContributions.astro";

import morataLandingImage from "../assets/projects/morata_landing.png?url";
import emedicardAdminReviewImage from "../assets/projects/emedicard/admin-review.png?url";
import emedicardCardTypeImage from "../assets/projects/emedicard/card-type.png?url";
import emedicardDocumentRequirementsImage from "../assets/projects/emedicard/document-requirements.png?url";
import emedicardHealthCardImage from "../assets/projects/emedicard/health-card.png?url";
import emedicardPaymentMethodsImage from "../assets/projects/emedicard/payment-methods.png?url";
import emedicardReviewSubmitImage from "../assets/projects/emedicard/review-submit.png?url";
import emedicardCertificateImage from "../assets/projects/emedicard/sample-health-certificate.svg?url";
import emedicardUploadDocumentsImage from "../assets/projects/emedicard/upload-documents.png?url";
import reactIcon from "../assets/tech-icons/react.svg?url";
import typescriptIcon from "../assets/tech-icons/typescript.svg?url";
import htmlIcon from "../assets/tech-icons/html.svg?url";
import vueIcon from "../assets/tech-icons/vue.svg?url";
import tailwindIcon from "../assets/tech-icons/tailwindcss.svg?url";
import nextIcon from "../assets/tech-icons/nextdotjs.svg?url";
import nuxtIcon from "../assets/tech-icons/nuxt.svg?url";
import astroIcon from "../assets/tech-icons/astro.svg?url";
import laravelIcon from "../assets/tech-icons/laravel.svg?url";
import phpIcon from "../assets/tech-icons/php.svg?url";
import pythonIcon from "../assets/tech-icons/python.svg?url";
import fastapiIcon from "../assets/tech-icons/fastapi.svg?url";
import nodeIcon from "../assets/tech-icons/nodedotjs.svg?url";
import postgresqlIcon from "../assets/tech-icons/postgresql.svg?url";
import convexIcon from "../assets/tech-icons/convex.svg?url";
import mysqlIcon from "../assets/tech-icons/mysql.svg?url";
import clerkIcon from "../assets/tech-icons/clerk.svg?url";
import dockerIcon from "../assets/tech-icons/docker.svg?url";
import cloudflareIcon from "../assets/tech-icons/cloudflare.svg?url";
import amazonS3Icon from "../assets/tech-icons/amazon-s3.svg?url";
import vercelIcon from "../assets/tech-icons/vercel.svg?url";
import railwayIcon from "../assets/tech-icons/railway.svg?url";
import expoIcon from "../assets/tech-icons/expo.svg?url";
import codexIcon from "../assets/tech-icons/codex.svg?url";
import claudeIcon from "../assets/tech-icons/claude.svg?url";
import antigravityIcon from "../assets/tech-icons/antigravity.svg?url";
import {
  ArrowUpRight,
  Database,
  ExternalLink,
  FileText,
  Layers,
  Mail,
  MapPin,
  ServerCog,
  Smartphone,
  Terminal,
  User,
  Briefcase,
  Bot,
  GraduationCap,
  Code,
  Globe,
  Menu,
  Moon,
  Sun,
  X,
} from "@lucide/astro";

export const prerender = true;

const cvHref = "/docs/cv.pdf";

const navItems = ["Projects", "Experience", "Skills", "Contact"];

const profileLinks = [
  {
    id: "link-github",
    label: "GitHub",
    href: "https://github.com/SeanPqul",
    icon: ExternalLink,
  },
  {
    id: "link-linkedin",
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/sean-paul-lapasanda-219117241/",
    icon: ExternalLink,
  },
  {
    id: "link-email",
    label: "Email",
    href: "mailto:seanpaullapasanda@gmail.com",
    icon: Mail,
  },
];

const skills = [
  {
    title: "Frontend",
    icon: Layers,
    items: ["React", "TypeScript", "HTML", "Tailwind CSS", "Next.js", "Nuxt.js", "Vue.js", "Astro"],
  },
  {
    title: "Backend",
    icon: Terminal,
    items: ["Laravel", "PHP", "Python", "FastAPI", "Node.js", "TypeScript", "PostgreSQL", "MySQL", "Convex DB", "Clerk"],
  },
  {
    title: "Cloud & DevOps",
    icon: Database,
    items: ["Docker", "Cloudflare", "Amazon S3", "Vercel", "Railway"],
  },
  {
    title: "Mobile",
    icon: Smartphone,
    items: ["React Native", "Expo", "Expo Router"],
  },
  {
    title: "AI Agents",
    icon: Bot,
    items: ["Codex", "Claude Code", "Antigravity"],
  },
];

const techIcons: Record<string, string> = {
  "React": reactIcon,
  "React Native": reactIcon,
  "TypeScript": typescriptIcon,
  "HTML": htmlIcon,
  "Tailwind CSS": tailwindIcon,
  "Next.js": nextIcon,
  "Nuxt.js": nuxtIcon,
  "Vue.js": vueIcon,
  "Astro": astroIcon,
  "Laravel": laravelIcon,
  "PHP": phpIcon,
  "Python": pythonIcon,
  "FastAPI": fastapiIcon,
  "Fast API": fastapiIcon,
  "Node.js": nodeIcon,
  "PostgreSQL": postgresqlIcon,
  "Convex DB": convexIcon,
  "MySQL": mysqlIcon,
  "Clerk": clerkIcon,
  "Docker": dockerIcon,
  "Cloudflare": cloudflareIcon,
  "Amazon S3": amazonS3Icon,
  "Vercel": vercelIcon,
  "Railway": railwayIcon,
  "Expo": expoIcon,
  "Expo Router": expoIcon,
  "Codex": codexIcon,
  "Claude Code": claudeIcon,
  "Antigravity": antigravityIcon,
};

const timelineItems = [
  {
    id: "ojt",
    type: "experience",
    role: "Software Developer Intern / OJT",
    company: "F.M. Morata Customs Brokerage & Law Firm",
    date: "Feb 2026 — May 2026",
    bullets: [
      "Built backend REST APIs using Laravel, implementing request validation and role access policies.",
      "Developed frontend features using React, TypeScript, and Vite, incorporating modular components and routing states.",
      "Improved document upload and transaction filtering workflows for brokerage operations."
    ],
    highlight: true,
    icon: Briefcase,
    accentColor: "text-mint",
    borderColor: "hover:border-mint/30",
    innerGlowColor: "group-hover:bg-mint/10",
    glowColor: "bg-mint/5",
    dotColor: "before:bg-mint",
    tag: "OJT Internship",
    techTags: ["Laravel", "React", "TypeScript", "MySQL"]
  },
  {
    id: "education",
    type: "education",
    role: "BS in Information Technology (BSIT)",
    company: "STI College Davao",
    date: "2022 — 2026",
    bullets: [
      "Studied core computer science and IT concepts, specializing in database systems, computer networking, and system design.",
      "Developed the EMEDICARD Capstone web and mobile health card management system using React Native, Expo, and Convex NoSQL.",
      "Implemented mobile QR code scanning verification and shared TypeScript schema validations across backend functions."
    ],
    highlight: false,
    icon: GraduationCap,
    accentColor: "text-sky",
    borderColor: "hover:border-sky/30",
    innerGlowColor: "group-hover:bg-sky/10",
    glowColor: "bg-sky/5",
    dotColor: "before:bg-sky",
    tag: "Academic Program",
    techTags: ["Database Management", "Systems Analysis", "Network Design", "Software Engineering", "OOP"]
  },
  {
    id: "mcdonalds",
    type: "experience",
    role: "Crew Trainer",
    company: "McDonald's Philippines",
    date: "Sep 2022 — Apr 2026",
    bullets: [
      "Trained and mentored new crew members on kitchen stations, operational procedures, and safety guidelines.",
      "Performed standard kitchen production and service crew duties while executing crew trainer responsibilities.",
      "Demonstrated strong time management by balancing shifts and training duties alongside full-time college studies."
    ],
    highlight: false,
    icon: McDonaldsIcon,
    accentColor: "text-amber",
    borderColor: "hover:border-amber/30",
    innerGlowColor: "group-hover:bg-amber/10",
    glowColor: "bg-amber/5",
    dotColor: "before:bg-amber",
    tag: "Operational Focus",
    techTags: ["Operations", "Time Management", "Teamwork"]
  },
  {
    id: "shs",
    type: "education",
    role: "TVL-ICT (CSS) NCII",
    company: "Cabantian National High School",
    date: "2020 — 2022",
    bullets: [
      "Completed the Technical-Vocational-Livelihood (TVL) Track, specializing in the Information and Communications Technology (ICT) Strand.",
      "Studied networking principles and completed hands-on training in computer systems installation, diagnostics, and network configuration.",
      "Completed specialized Computer Systems Servicing (CSS) NC II server installation training at Interface Computer College through the Joint Delivery Voucher Program (JDVP), successfully earning the TESDA NC II credential."
    ],
    highlight: false,
    icon: Code,
    accentColor: "text-[#a78bfa]",
    borderColor: "hover:border-[#a78bfa]/30",
    innerGlowColor: "group-hover:bg-[#a78bfa]/10",
    glowColor: "bg-[#a78bfa]/5",
    dotColor: "before:bg-[#a78bfa]",
    tag: "Secondary Education",
    techTags: ["Computer Systems Servicing", "Computer Networking", "Server Configuration"]
  },
];
---

<MainLayout
  title="Sean Paul Lapasanda | Full Stack Software Engineer"
  description="Portfolio of Sean Paul S. Lapasanda, a full-stack engineer building Laravel, React, React Native, and TypeScript systems."
>
  <header class="page-shell sticky top-0 z-50 py-3 sm:py-4">
    <nav
      class="glass grid min-w-0 grid-cols-[minmax(0,1fr)_auto] items-center gap-3 rounded-2xl px-3 py-3 text-sm text-ink sm:rounded-full sm:px-5 sm:py-3.5 md:flex md:flex-wrap md:justify-between"
      aria-label="Primary navigation"
    >
      <a href="#top" id="logo" class="flex min-w-0 items-center gap-2 font-semibold group">
        <Logo class="size-9 shrink-0 sm:size-8" />
        <span class="font-display text-sm font-bold tracking-tight text-ink transition-colors group-hover:text-mint sm:text-base">Ichihara</span>
      </a>
      <div class="hidden items-center gap-1.5 md:flex">
        {
          navItems.map((item) => (
            <a
              id={`nav-link-${item.toLowerCase()}`}
              href={`#${item.toLowerCase()}`}
              class="rounded-full px-4 py-2 text-muted font-medium transition hover:bg-white/8 hover:text-ink"
            >
              {item}
            </a>
          ))
        }
      </div>
      <div class="flex min-w-0 items-center justify-end gap-2">
        <a
          id="nav-contact-button"
          href="#contact"
          aria-label="Contact Ichihara"
          class="hidden min-h-10 shrink-0 items-center justify-center gap-2 rounded-full bg-ink px-4 py-2 text-xs font-bold text-bg-deep transition hover:-translate-y-0.5 hover:bg-mint hover:shadow-lg hover:shadow-mint/20 md:inline-flex"
        >
          <Mail size={14} />
          <span>Let's Talk</span>
        </a>
        <button
          id="theme-toggle"
          type="button"
          class="theme-toggle grid size-11 shrink-0 place-items-center rounded-full text-ink transition hover:-translate-y-0.5 hover:border-mint hover:text-mint sm:size-10"
          aria-label="Switch color theme"
          aria-pressed="false"
        >
          <Sun size={17} class="theme-icon-sun" />
          <Moon size={17} class="theme-icon-moon" />
          <span class="sr-only">Toggle color theme</span>
        </button>
        <button
          id="mobile-menu-toggle"
          type="button"
          class="inline-flex min-h-11 max-w-full shrink-0 items-center justify-center gap-2 rounded-full border border-white/8 bg-white/[0.03] px-3.5 text-xs font-bold text-ink transition hover:border-mint hover:text-mint md:hidden"
          aria-controls="mobile-nav-panel"
          aria-expanded="false"
        >
          <Menu size={16} />
          <span id="mobile-menu-label">Menu</span>
        </button>
      </div>
      <div
        id="mobile-nav-panel"
        class="col-span-2 hidden w-full border-t border-white/8 pt-3 md:hidden"
      >
        <div class="grid gap-2">
        {
          navItems.map((item) => (
            <a
              id={`mobile-nav-link-${item.toLowerCase()}`}
              href={`#${item.toLowerCase()}`}
              class="mobile-nav-link inline-flex min-h-11 items-center justify-between rounded-xl border border-white/6 bg-white/[0.02] px-4 text-sm font-semibold text-muted transition hover:border-mint hover:text-mint"
            >
              <span>{item}</span>
              <ArrowUpRight size={15} />
            </a>
          ))
        }
        </div>
      </div>
    </nav>
  </header>

  <main id="top">
    <!-- Hero Section -->
    <section class="page-shell grid items-center gap-8 py-6 sm:gap-10 sm:py-8 lg:min-h-[calc(100svh-5.5rem)] lg:grid-cols-[1.1fr_0.9fr] lg:py-6">
      <div class="scroll-reveal">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs text-ink/90">
          <Globe size={14} class="text-mint" />
          <span>Available for remote & hybrid opportunities</span>
        </div>
        <h1 class="fluid-heading max-w-4xl font-display font-extrabold leading-[1.05] tracking-tight text-ink sm:text-balance">
          <span class="block sm:inline">Full-stack developer</span>
          <span class="block sm:inline"> building <span class="text-mint">web</span> and</span>
          <span class="block sm:inline"> <span class="text-sky">mobile</span> applications.</span>
        </h1>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted">
          I build web systems and mobile apps that digitize real operations — backed by structured databases, secure APIs, and clean user interfaces.
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-4">
          <a
            id="hero-cta-projects"
            href="#projects"
            class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-mint px-5.5 py-3 text-sm font-extrabold text-[#07100d] transition hover:-translate-y-0.5 hover:bg-[#7af0c8] hover:shadow-lg hover:shadow-mint/20 sm:justify-start"
          >
            <Briefcase size={18} />
            View Work
          </a>
          <a
            id="hero-cta-cv"
            href={cvHref}
            target="_blank"
            rel="noreferrer"
            class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-mint px-5.5 py-3 text-sm font-extrabold text-[#07100d] transition hover:-translate-y-0.5 hover:bg-[#7af0c8] hover:shadow-lg hover:shadow-mint/20 sm:justify-start"
          >
            <FileText size={18} />
            View CV
          </a>
        </div>
        <div class="mt-8 grid grid-cols-2 items-center gap-3 text-xs text-muted sm:flex sm:flex-wrap sm:gap-4">
          <span class="inline-flex items-center gap-2 rounded-full border border-white/6 bg-white/[0.02] px-3.5 py-2">
            <MapPin size={14} class="text-sky" />
            Philippines
          </span>
          {
            profileLinks.map(({ id, label, href, icon: Icon }) => (
              <a
                id={id}
                href={href}
                target={href.startsWith("http") ? "_blank" : undefined}
                rel={href.startsWith("http") ? "noreferrer" : undefined}
                class="inline-flex min-h-10 items-center gap-2 rounded-full border border-white/6 bg-white/[0.01] px-3.5 py-2 hover:border-mint hover:text-mint"
              >
                <Icon size={14} />
                {label}
              </a>
            ))
          }
          
          <!-- Interactive CLI Toggle Button (UX Pattern C) -->
          <button
            id="hero-cli-toggle"
            class="col-span-2 inline-flex min-h-10 items-center justify-center gap-2 rounded-full border border-amber/30 bg-white/[0.02] px-3.5 py-2 font-mono text-amber transition-all duration-300 hover:scale-102 hover:border-mint hover:text-mint cursor-pointer select-none sm:col-span-1 sm:justify-start"
            aria-label="Toggle CLI Terminal"
          >
            <span id="hero-cli-icon-terminal" class="hidden items-center">
              <Terminal size={14} class="text-mint shrink-0" />
            </span>
            <span id="hero-cli-icon-profile" class="flex items-center">
              <User size={14} class="text-sky shrink-0" />
            </span>
            <span id="hero-cli-text" class="text-ink">Close CLI</span>
          </button>
        </div>
      </div>

      <!-- Right Column: Interactive CLI & profile -->
      <div class="scroll-reveal" style="transition-delay: 150ms;">
        <DeveloperDeck />
      </div>
    </section>

    <!-- GitHub Activity Telemetry Section (Directly Below Landing/Hero) -->
    <section id="activity" class="page-shell pb-6 sm:pb-8">
      <GithubContributions />
    </section>

    <!-- Projects Section -->
    <section id="projects" class="relative border-y border-white/10 bg-bg-card pt-8 pb-14 sm:pt-10 sm:pb-16 lg:pt-12 lg:pb-20">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-mint/30 to-transparent"></div>
      <div class="absolute left-1/2 top-24 h-72 w-3/4 -translate-x-1/2 rounded-full bg-mint/5 blur-3xl pointer-events-none"></div>

      <div class="page-shell relative z-10">
        <div class="mb-8 flex flex-col gap-5 scroll-reveal lg:flex-row lg:items-end lg:justify-between">
          <div class="max-w-3xl">
            <h2 class="font-display text-3xl font-extrabold leading-tight text-ink sm:text-4xl">
              Projects
            </h2>
            <p class="mt-2.5 max-w-2xl text-sm leading-relaxed text-muted">
              Systems built across internship, capstone, and personal development in web and mobile.
            </p>
          </div>
          <div class="flex w-fit items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 text-xs text-muted">
            <span class="font-mono font-bold text-mint">03</span>
            projects
          </div>
        </div>

        <!-- 3-Column Card Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
          
          <!-- Card 1: MorataFMS -->
          <article class="group scroll-reveal flex flex-col justify-between rounded-2xl border border-slate-200/80 bg-white/80 p-5 sm:p-6 shadow-xl transition-all duration-300 hover:-translate-y-1 hover:border-mint/50 hover:shadow-[0_0_20px_rgba(102,224,181,0.15)] dark:border-white/10 dark:bg-bg-deep/55 dark:shadow-2xl">
            <div class="flex flex-col flex-1">
              <!-- Top Row Badges -->
              <div class="flex flex-wrap items-center gap-2 sm:gap-2.5">
                <span class="rounded-md border border-mint/25 bg-mint/8 px-2 py-0.5 font-mono text-xs font-black text-mint">01</span>
                <span class="inline-flex items-center gap-1.5 rounded-full border border-mint/15 bg-mint/8 px-2.5 py-0.5 text-xs font-bold text-mint">
                  <ServerCog size={12} />
                  Web App
                </span>
                <span class="rounded-full border border-slate-200/80 bg-slate-100/80 px-2.5 py-0.5 text-[11px] font-medium text-slate-600 dark:border-white/8 dark:bg-white/[0.03] dark:text-muted">
                  OJT Project
                </span>
              </div>

              <!-- Title & Description -->
              <h3 class="mt-4 font-display text-xl sm:text-2xl font-extrabold text-slate-900 transition-colors group-hover:text-mint dark:text-ink">
                MorataFMS
              </h3>
              <p class="mt-2.5 text-sm leading-relaxed text-slate-600 dark:text-muted flex-1">
                An operations system for brokerage and legal workflows, focused on import/export transaction tracking, document handling, archiving, and role-based access.
              </p>

              <!-- Tech Stack Chips -->
              <div class="mt-4 flex flex-wrap gap-1.5">
                {["Laravel", "React", "TypeScript", "Vite", "MySQL"].map((tech) => (
                  <span class="rounded-lg border border-slate-200/70 bg-slate-50/70 px-2 py-0.5 font-mono text-[11px] font-medium text-slate-600 dark:border-white/8 dark:bg-white/[0.03] dark:text-muted">
                    {tech}
                  </span>
                ))}
              </div>
            </div>

            <!-- CTA Trigger -->
            <div class="mt-6 pt-4 border-t border-slate-200/80 dark:border-white/8">
              <button
                type="button"
                class="project-modal-trigger inline-flex w-full items-center justify-center gap-2 rounded-xl border border-mint/30 bg-mint/10 py-2.5 text-xs font-extrabold text-mint transition hover:bg-mint hover:text-bg-deep cursor-pointer"
                data-project-modal-target="morata-modal"
                aria-haspopup="dialog"
              >
                <span>View Details</span>
                <ArrowUpRight size={14} />
              </button>
            </div>
          </article>

          <!-- Card 2: EMEDICARD -->
          <article class="group scroll-reveal flex flex-col justify-between rounded-2xl border border-slate-200/80 bg-white/80 p-5 sm:p-6 shadow-xl transition-all duration-300 hover:-translate-y-1 hover:border-sky/50 hover:shadow-[0_0_20px_rgba(104,196,255,0.15)] dark:border-white/10 dark:bg-bg-deep/55 dark:shadow-2xl" style="transition-delay: 100ms;">
            <div class="flex flex-col flex-1">
              <!-- Top Row Badges -->
              <div class="flex flex-wrap items-center gap-2 sm:gap-2.5">
                <span class="rounded-md border border-sky/25 bg-sky/8 px-2 py-0.5 font-mono text-xs font-black text-sky">02</span>
                <span class="inline-flex items-center gap-1.5 rounded-full border border-sky/15 bg-sky/8 px-2.5 py-0.5 text-xs font-bold text-sky">
                  <Smartphone size={12} />
                  Web & Mobile
                </span>
                <span class="rounded-full border border-slate-200/80 bg-slate-100/80 px-2.5 py-0.5 text-[11px] font-medium text-slate-600 dark:border-white/8 dark:bg-white/[0.03] dark:text-muted">
                  Capstone
                </span>
              </div>

              <!-- Title & Description -->
              <h3 class="mt-4 font-display text-xl sm:text-2xl font-extrabold text-slate-900 transition-colors group-hover:text-sky dark:text-ink">
                EMEDICARD
              </h3>
              <p class="mt-2.5 text-sm leading-relaxed text-slate-600 dark:text-muted flex-1">
                A web and mobile health card management system for classification-based applications, required document uploads, admin review, QR verification, and generated certificates.
              </p>

              <!-- Tech Stack Chips -->
              <div class="mt-4 flex flex-wrap gap-1.5">
                {["React Native", "Expo", "Next.js", "TypeScript", "Convex", "Clerk"].map((tech) => (
                  <span class="rounded-lg border border-slate-200/70 bg-slate-50/70 px-2 py-0.5 font-mono text-[11px] font-medium text-slate-600 dark:border-white/8 dark:bg-white/[0.03] dark:text-muted">
                    {tech}
                  </span>
                ))}
              </div>
            </div>

            <!-- CTA Trigger -->
            <div class="mt-6 pt-4 border-t border-slate-200/80 dark:border-white/8">
              <button
                type="button"
                class="project-modal-trigger inline-flex w-full items-center justify-center gap-2 rounded-xl border border-sky/30 bg-sky/10 py-2.5 text-xs font-extrabold text-sky transition hover:bg-sky hover:text-bg-deep cursor-pointer"
                data-project-modal-target="emedicard-modal"
                aria-haspopup="dialog"
              >
                <span>View Details</span>
                <ArrowUpRight size={14} />
              </button>
            </div>
          </article>

          <!-- Card 3: Developer Portfolio & CLI Platform -->
          <article class="group scroll-reveal flex flex-col justify-between rounded-2xl border border-slate-200/80 bg-white/80 p-5 sm:p-6 shadow-xl transition-all duration-300 hover:-translate-y-1 hover:border-amber/50 hover:shadow-[0_0_20px_rgba(255,184,77,0.15)] dark:border-white/10 dark:bg-bg-deep/55 dark:shadow-2xl" style="transition-delay: 200ms;">
            <div class="flex flex-col flex-1">
              <!-- Top Row Badges -->
              <div class="flex flex-wrap items-center gap-2 sm:gap-2.5">
                <span class="rounded-md border border-amber/25 bg-amber/8 px-2 py-0.5 font-mono text-xs font-black text-amber">03</span>
