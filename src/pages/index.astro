---
import MainLayout from "../layouts/MainLayout.astro";
import DeveloperDeck from "../components/DeveloperDeck.astro";
import McDonaldsIcon from "../components/McDonaldsIcon.astro";
import {
  ArrowUpRight,
  Database,
  ExternalLink,
  Layers,
  Mail,
  MapPin,
  ServerCog,
  Smartphone,
  Terminal,
  User,
  Send,
  Briefcase,
  Bot,
  GraduationCap,
  Code,
  Globe,
  Menu,
  X,
} from "@lucide/astro";

export const prerender = true;

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

const navItems = ["Projects", "Experience", "Skills", "Contact"];

const profileLinks = [
  {
    id: "link-github",
    label: "GitHub",
    href: "https://github.com/SeanPqul",
    icon: ExternalLink,
  },
  {
    id: "link-linkedin",
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/sean-paul-lapasanda-219117241/",
    icon: ExternalLink,
  },
  {
    id: "link-email",
    label: "Email",
    href: "mailto:seanpaullapasanda@gmail.com",
    icon: Mail,
  },
];

const highlights = [
  {
    value: "Laravel & React",
    label: "web applications",
  },
  {
    value: "React Native & Expo",
    label: "mobile applications",
  },
  {
    value: "APIs & Databases",
    label: "backend integrations",
  },
];

const skills = [
  {
    title: "Frontend",
    icon: Layers,
    items: ["React", "TypeScript", "Vite", "Tailwind CSS", "Next.js", "Nuxt.js"],
  },
  {
    title: "Backend",
    icon: Terminal,
    items: ["Laravel", "PHP", "Node.js", "TypeScript", "Convex Functions", "MySQL", "Convex DB", "Clerk"],
  },
  {
    title: "Cloud & DevOps",
    icon: Database,
    items: ["Docker", "Cloudflare", "Amazon S3"],
  },
  {
    title: "Mobile",
    icon: Smartphone,
    items: ["React Native", "Expo", "Expo Router"],
  },
  {
    title: "AI Agents",
    icon: Bot,
    items: ["Codex", "Claude Code", "Antigravity"],
  },
];

const techIcons: Record<string, string> = {
  "React": "/tech-icons/react.svg",
  "React Native": "/tech-icons/react.svg",
  "TypeScript": "/tech-icons/typescript.svg",
  "Vite": "/tech-icons/vite.svg",
  "Tailwind CSS": "/tech-icons/tailwindcss.svg",
  "Next.js": "/tech-icons/nextdotjs.svg",
  "Nuxt.js": "/tech-icons/nuxt.svg",
  "Laravel": "/tech-icons/laravel.svg",
  "PHP": "/tech-icons/php.svg",
  "Node.js": "/tech-icons/nodedotjs.svg",
  "Convex Functions": "/tech-icons/convex-functions.svg",
  "Convex DB": "/tech-icons/convex.svg",
  "MySQL": "/tech-icons/mysql.svg",
  "Clerk": "/tech-icons/clerk.svg",
  "Docker": "/tech-icons/docker.svg",
  "Cloudflare": "/tech-icons/cloudflare.svg",
  "Amazon S3": "/tech-icons/amazon-s3.svg",
  "Expo": "/tech-icons/expo.svg",
  "Expo Router": "/tech-icons/expo.svg",
  "Codex": "/tech-icons/codex.svg",
  "Claude Code": "/tech-icons/claude.svg",
  "Antigravity": "/tech-icons/antigravity.svg",
};

const timelineItems = [
  {
    id: "ojt",
    type: "experience",
    role: "Software Developer Intern / OJT",
    company: "F.M. Morata Customs Brokerage & Law Firm",
    date: "Feb 2026 — May 2026",
    bullets: [
      "Built backend REST APIs using Laravel, implementing request validation and role access policies.",
      "Developed frontend features using React, TypeScript, and Vite, incorporating modular components and routing states.",
      "Improved document upload and transaction filtering workflows for brokerage operations."
    ],
    highlight: true,
    icon: Briefcase,
    accentColor: "text-mint",
    borderColor: "hover:border-mint/30",
    innerGlowColor: "group-hover:bg-mint/10",
    glowColor: "bg-mint/5",
    dotColor: "before:bg-mint",
    tag: "OJT Internship",
    techTags: ["Laravel", "React", "TypeScript", "MySQL"]
  },
  {
    id: "education",
    type: "education",
    role: "BS in Information Technology (BSIT)",
    company: "STI College Davao",
    date: "2022 — 2026",
    bullets: [
      "Studied core computer science and IT concepts, specializing in database systems, computer networking, and system design.",
      "Developed the EMEDICARD Capstone web and mobile health card management system using React Native, Expo, and Convex NoSQL.",
      "Implemented mobile QR code scanning verification and shared TypeScript schema validations across backend functions."
    ],
    highlight: false,
    icon: GraduationCap,
    accentColor: "text-sky",
    borderColor: "hover:border-sky/30",
    innerGlowColor: "group-hover:bg-sky/10",
    glowColor: "bg-sky/5",
    dotColor: "before:bg-sky",
    tag: "Academic Program",
    techTags: ["Database Management", "Systems Analysis", "Network Design", "Software Engineering", "OOP"]
  },
  {
    id: "mcdonalds",
    type: "experience",
    role: "Crew Trainer",
    company: "McDonald's Philippines",
    date: "Sep 2022 — Apr 2026",
    bullets: [
      "Trained and mentored new crew members on kitchen stations, operational procedures, and safety guidelines.",
      "Performed standard kitchen production and service crew duties while executing crew trainer responsibilities.",
      "Demonstrated strong time management by balancing shifts and training duties alongside full-time college studies."
    ],
    highlight: false,
    icon: McDonaldsIcon,
    accentColor: "text-amber",
    borderColor: "hover:border-amber/30",
    innerGlowColor: "group-hover:bg-amber/10",
    glowColor: "bg-amber/5",
    dotColor: "before:bg-amber",
    tag: "Operational Focus",
    techTags: ["Operations", "Time Management", "Teamwork"]
  },
  {
    id: "shs",
    type: "education",
    role: "TVL-ICT (CSS) NCII",
    company: "Cabantian National High School",
    date: "2020 — 2022",
    bullets: [
      "Completed the Technical-Vocational-Livelihood (TVL) Track, specializing in the Information and Communications Technology (ICT) Strand.",
      "Studied networking principles and completed hands-on training in computer systems installation, diagnostics, and network configuration.",
      "Completed specialized Computer Systems Servicing (CSS) NC II server installation training at Interface Computer College through the Joint Delivery Voucher Program (JDVP), successfully earning the TESDA NC II credential."
    ],
    highlight: false,
    icon: Code,
    accentColor: "text-[#a78bfa]",
    borderColor: "hover:border-[#a78bfa]/30",
    innerGlowColor: "group-hover:bg-[#a78bfa]/10",
    glowColor: "bg-[#a78bfa]/5",
    dotColor: "before:bg-[#a78bfa]",
    tag: "Secondary Education",
    techTags: ["Computer Systems Servicing", "Computer Networking", "Server Configuration"]
  },
];
---

<MainLayout
  title="Sean Paul Lapasanda | Full Stack Software Engineer"
  description="Portfolio of Sean Paul S. Lapasanda, a full-stack engineer building Laravel, React, React Native, and TypeScript systems."
>
  <header class="page-shell sticky top-0 z-50 py-3 sm:py-4">
    <nav
      class="glass grid min-w-0 grid-cols-[minmax(0,1fr)_auto] items-center gap-3 rounded-2xl px-3 py-3 text-sm text-ink sm:rounded-full sm:px-5 sm:py-3.5 md:flex md:flex-wrap md:justify-between"
      aria-label="Primary navigation"
    >
      <a href="#top" id="logo" class="flex min-w-0 items-center gap-2 font-semibold group">
        <span class="grid size-9 shrink-0 place-items-center rounded-full bg-mint text-bg-deep transition-transform duration-300 group-hover:scale-105 sm:size-8">
          <Terminal size={17} />
        </span>
        <span class="font-display text-sm font-bold tracking-tight text-ink transition-colors group-hover:text-mint sm:text-base">Sean Paul</span>
      </a>
      <div class="hidden items-center gap-1.5 md:flex">
        {
          navItems.map((item) => (
            <a
              id={`nav-link-${item.toLowerCase()}`}
              href={`#${item.toLowerCase()}`}
              class="rounded-full px-4 py-2 text-muted font-medium transition hover:bg-white/8 hover:text-ink"
            >
              {item}
            </a>
          ))
        }
      </div>
      <a
        id="nav-contact-button"
        href="#contact"
        aria-label="Contact Sean Paul"
        class="hidden min-h-10 shrink-0 items-center justify-center gap-2 rounded-full bg-ink px-4 py-2 text-xs font-bold text-bg-deep transition hover:-translate-y-0.5 hover:bg-mint hover:shadow-lg hover:shadow-mint/20 md:inline-flex"
      >
        <Mail size={14} />
        <span>Let's Talk</span>
      </a>
      <button
        id="mobile-menu-toggle"
        type="button"
        class="inline-flex min-h-11 max-w-full shrink-0 items-center justify-center gap-2 rounded-full border border-white/8 bg-white/[0.03] px-3.5 text-xs font-bold text-ink transition hover:border-mint hover:text-mint md:hidden"
        aria-controls="mobile-nav-panel"
        aria-expanded="false"
      >
        <Menu size={16} />
        <span id="mobile-menu-label">Menu</span>
      </button>
      <div
        id="mobile-nav-panel"
        class="col-span-2 hidden w-full border-t border-white/8 pt-3 md:hidden"
      >
        <div class="grid gap-2">
        {
          navItems.map((item) => (
            <a
              id={`mobile-nav-link-${item.toLowerCase()}`}
              href={`#${item.toLowerCase()}`}
              class="mobile-nav-link inline-flex min-h-11 items-center justify-between rounded-xl border border-white/6 bg-white/[0.02] px-4 text-sm font-semibold text-muted transition hover:border-mint hover:text-mint"
            >
              <span>{item}</span>
              <ArrowUpRight size={15} />
            </a>
          ))
        }
        </div>
      </div>
    </nav>
  </header>

  <main id="top">
    <!-- Hero Section -->
    <section class="page-shell grid items-center gap-10 py-10 sm:py-12 lg:min-h-[calc(100svh-6rem)] lg:grid-cols-[1.1fr_0.9fr] lg:py-14">
      <div class="scroll-reveal">
        <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs text-ink/90">
          <Globe size={14} class="text-mint" />
          <span>Available for remote & hybrid opportunities</span>
        </div>
        <h1 class="fluid-heading max-w-4xl font-display font-extrabold leading-[1.05] tracking-tight text-ink sm:text-balance">
          <span class="block sm:inline">Full-stack developer</span>
          <span class="block sm:inline"> building <span class="text-mint">web</span> and</span>
          <span class="block sm:inline"> <span class="text-sky">mobile</span> applications.</span>
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-relaxed text-[#cfc6b8]">
          I build web systems and mobile apps that digitize real operations — backed by structured databases, secure APIs, and clean user interfaces.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-4">
          <a
            id="hero-cta-projects"
            href="#projects"
            class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-mint px-5.5 py-3 text-sm font-extrabold text-[#07100d] transition hover:-translate-y-0.5 hover:bg-[#7af0c8] hover:shadow-lg hover:shadow-mint/20 sm:justify-start"
          >
            Explore Projects
            <ArrowUpRight size={18} />
          </a>
          <a
            id="hero-cta-contact"
            href="#contact"
            class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full border border-white/15 px-5.5 py-3 text-sm font-bold text-ink transition hover:-translate-y-0.5 hover:border-amber hover:text-amber sm:justify-start"
          >
            <Mail size={18} />
            Get in Touch
          </a>
        </div>
        <div class="mt-10 grid grid-cols-2 items-center gap-3 text-xs text-muted sm:flex sm:flex-wrap sm:gap-4">
          <span class="inline-flex items-center gap-2 rounded-full border border-white/6 bg-white/[0.02] px-3.5 py-2">
            <MapPin size={14} class="text-sky" />
            Philippines
          </span>
          {
            profileLinks.map(({ id, label, href, icon: Icon }) => (
              <a
                id={id}
                href={href}
                target={href.startsWith("http") ? "_blank" : undefined}
                rel={href.startsWith("http") ? "noreferrer" : undefined}
                class="inline-flex min-h-10 items-center gap-2 rounded-full border border-white/6 bg-white/[0.01] px-3.5 py-2 hover:border-mint hover:text-mint"
              >
                <Icon size={14} />
                {label}
              </a>
            ))
          }
          
          <!-- Interactive CLI Toggle Button (UX Pattern C) -->
          <button
            id="hero-cli-toggle"
            class="col-span-2 inline-flex min-h-10 items-center justify-center gap-2 rounded-full border border-white/6 bg-white/[0.02] px-3.5 py-2 font-mono transition-all duration-300 hover:scale-102 hover:border-mint hover:text-mint cursor-pointer select-none sm:col-span-1 sm:justify-start"
            aria-label="Toggle CLI Terminal"
          >
            <span id="hero-cli-icon-terminal" class="flex items-center">
              <Terminal size={14} class="text-mint shrink-0" />
            </span>
            <span id="hero-cli-icon-profile" class="hidden items-center">
              <User size={14} class="text-sky shrink-0" />
            </span>
            <span id="hero-cli-text" class="text-ink">Launch CLI</span>
          </button>
        </div>
      </div>

      <!-- Right Column: Interactive CLI & profile -->
      <div class="scroll-reveal" style="transition-delay: 150ms;">
        <DeveloperDeck />
      </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="fluid-section relative border-y border-white/10 bg-bg-card">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-mint/30 to-transparent"></div>
      <div class="absolute left-1/2 top-24 h-72 w-3/4 -translate-x-1/2 rounded-full bg-mint/5 blur-3xl pointer-events-none"></div>

      <div class="page-shell relative z-10">
        <div class="mb-8 flex flex-col gap-5 scroll-reveal lg:flex-row lg:items-end lg:justify-between">
          <div class="max-w-3xl">
            <p class="section-kicker">Featured Work</p>
            <h2 class="mt-3 font-display text-3xl font-extrabold leading-tight text-ink sm:text-4xl">
              Selected systems across web, backend, and mobile workflows.
            </h2>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">
              Two focused projects from internship and capstone work, summarized by product context, contribution focus, and stack.
            </p>
          </div>
          <div class="flex w-fit items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 text-xs text-muted">
            <span class="font-mono font-bold text-mint">02</span>
            selected projects
          </div>
        </div>

        <div class="space-y-4">
          <article class="group scroll-reveal rounded-2xl border border-white/10 bg-bg-deep/55 p-5 transition-all duration-300 hover:border-mint/30 sm:p-6">
            <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-start">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-3">
                  <span class="rounded-md border border-mint/25 bg-mint/8 px-2.5 py-1 font-mono text-xs font-black text-mint">01</span>
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-mint/15 bg-mint/8 px-3 py-1 text-xs font-bold text-mint">
                    <ServerCog size={13} />
                    Web Application
                  </span>
                  <span class="rounded-full border border-white/8 bg-white/[0.03] px-3 py-1 text-xs text-muted">OJT Project</span>
                </div>
                <h3 class="mt-4 font-display text-2xl font-extrabold text-ink">MorataFMS</h3>
                <p class="mt-3 max-w-3xl text-sm leading-relaxed text-[#cfc6b8]">
                  An operations system for brokerage and legal workflows, focused on import/export transaction tracking, document handling, archiving, and role-based access.
                </p>
                <div class="mt-5 flex flex-wrap gap-2">
                  {["Laravel", "React", "TypeScript", "Vite", "MySQL"].map((tech) => (
                    <span class="rounded-full border border-white/8 bg-white/[0.03] px-3 py-1 text-xs font-medium text-muted">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>

              <button
                type="button"
                class="project-modal-trigger inline-flex w-fit items-center gap-2 rounded-full border border-mint/20 bg-mint/10 px-4 py-2 text-xs font-extrabold text-mint transition hover:bg-mint hover:text-bg-deep lg:col-span-2"
                data-project-modal-target="morata-modal"
                aria-haspopup="dialog"
              >
                View Details
                <ArrowUpRight size={14} />
              </button>
            </div>
          </article>

          <article class="group scroll-reveal rounded-2xl border border-white/10 bg-bg-deep/55 p-5 transition-all duration-300 hover:border-sky/30 sm:p-6">
            <div class="grid gap-5">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-3">
                  <span class="rounded-md border border-sky/25 bg-sky/8 px-2.5 py-1 font-mono text-xs font-black text-sky">02</span>
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-sky/15 bg-sky/8 px-3 py-1 text-xs font-bold text-sky">
                    <Smartphone size={13} />
                    Web & Mobile System
                  </span>
                  <span class="rounded-full border border-white/8 bg-white/[0.03] px-3 py-1 text-xs text-muted">Capstone</span>
                </div>
                <h3 class="mt-4 font-display text-2xl font-extrabold text-ink">EMEDICARD</h3>
                <p class="mt-3 max-w-3xl text-sm leading-relaxed text-[#cfc6b8]">
                  A web and mobile health card management system for classification-based applications, required document uploads, admin review, payment/orientation, QR verification, and generated certificates.
                </p>
                <div class="mt-5 flex flex-wrap gap-2">
                  {["React Native", "Expo", "Next.js", "TypeScript", "Convex", "Clerk"].map((tech) => (
                    <span class="rounded-full border border-white/8 bg-white/[0.03] px-3 py-1 text-xs font-medium text-muted">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>

              <button
                type="button"
                class="project-modal-trigger inline-flex w-fit items-center gap-2 rounded-full border border-sky/20 bg-sky/10 px-4 py-2 text-xs font-extrabold text-sky transition hover:bg-sky hover:text-bg-deep"
                data-project-modal-target="emedicard-modal"
                aria-haspopup="dialog"
              >
                View Details
                <ArrowUpRight size={14} />
              </button>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Experience Section -->
    <section id="experience" class="page-shell fluid-section">
      <div class="mb-12 scroll-reveal text-center">
        <p class="section-kicker">Journey</p>
        <h2 class="mt-3 font-display text-3xl font-extrabold text-ink sm:text-4xl">
          Work &amp; Education
        </h2>
      </div>

      <!-- Alternating Split Timeline Container -->
      <div class="relative space-y-12 lg:space-y-6 mt-10">
        <!-- Vertical Center Timeline Line -->
        <div class="absolute left-3.5 lg:left-1/2 lg:-translate-x-1/2 top-2 bottom-2 w-[1px] bg-white/10"></div>

        {
          timelineItems.map((item) => (
            <div class="relative flex flex-col lg:flex-row items-center justify-between w-full group/timeline">
              <!-- Center Dot Node -->
              <div class="absolute left-3.5 lg:left-1/2 lg:-translate-x-1/2 top-[38px] lg:top-1/2 lg:-translate-y-1/2 z-10 flex flex-col items-center">
                <div class={`w-3.5 h-3.5 rounded-full border-2 transition-transform duration-300 group-hover/timeline:scale-125 bg-bg-deep ${
                  item.highlight 
                    ? `${item.accentColor} border-current shadow-[0_0_8px_rgba(255,255,255,0.15)]`
                    : `border-white/20 group-hover/timeline:border-current ${item.accentColor}`
                }`}></div>
              </div>

              <!-- Left Column: Education details on left, hidden spacer for experience -->
              <div class={`w-full lg:w-[calc(50%-2.5rem)] order-1 ${item.type === 'education' ? 'block pl-10 lg:pl-0' : 'hidden lg:block lg:opacity-0 lg:pointer-events-none'}`}>
                {item.type === 'education' && (
                  <article class={`scroll-reveal glass rounded-2xl border border-white/8 p-4 sm:p-5 ${item.borderColor} hover:-translate-y-0.5 transition-all duration-300 relative overflow-hidden group/card flex flex-col justify-between`}>
                    <span class={`absolute -right-8 -top-8 size-20 ${item.glowColor} rounded-full blur-xl ${item.innerGlowColor} transition-all duration-300 pointer-events-none`}></span>
                    
                    <div>
                      <!-- Header -->
                      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                        <div class="flex min-w-0 items-center gap-3">
                          <span class={`grid size-9 place-items-center rounded-xl bg-white/[0.03] border border-white/8 ${item.accentColor}`}>
                            <item.icon size={18} />
                          </span>
                          <span class="text-[9px] font-mono font-bold tracking-widest text-muted uppercase">
                            {item.tag}
                          </span>
                        </div>
                        <span class="w-fit rounded-full border border-white/5 bg-white/5 px-2 py-0.5 font-mono text-[9px] text-muted">
                          {item.date}
                        </span>
                      </div>

                      <!-- Title & Company -->
                      <div class="mt-3.5 text-left">
                        <h3 class={`text-base font-bold font-display transition-colors group-hover/card:${item.accentColor} ${item.highlight ? item.accentColor : "text-ink"}`}>
                          {item.role}
                        </h3>
                        <p class="text-xs text-muted font-medium mt-1">{item.company}</p>
                      </div>

                      <!-- Bullets -->
                      <ul class="mt-4 space-y-2.5 text-xs text-[#cfc6b8] list-none leading-relaxed text-left">
                        {item.bullets.map((bullet) => (
                          <li class={`relative pl-4 before:absolute before:left-0 before:top-2 before:size-1.5 before:rounded-full ${item.dotColor}`}>
                            {bullet}
                          </li>
                        ))}
                      </ul>
                    </div>

                    <!-- Tech Tags -->
                    {item.techTags && item.techTags.length > 0 && (
                      <div class="mt-5 flex flex-wrap gap-1 justify-start">
                        {item.techTags.map((tech) => (
                          <span class="rounded bg-white/4 border border-white/5 px-2 py-0.5 text-[10px] font-medium text-muted transition-colors group-hover/card:border-current group-hover/card:text-ink">
                            {tech}
                          </span>
                        ))}
                      </div>
                    )}
                  </article>
                )}
              </div>

              <!-- Right Column: Experience details on right, hidden spacer for education -->
              <div class={`w-full lg:w-[calc(50%-2.5rem)] order-2 ${item.type === 'experience' ? 'block pl-10 lg:pl-0' : 'hidden lg:block lg:opacity-0 lg:pointer-events-none'}`}>
                {item.type === 'experience' && (
                  <article class={`scroll-reveal glass rounded-2xl border border-white/8 p-4 sm:p-5 ${item.borderColor} hover:-translate-y-0.5 transition-all duration-300 relative overflow-hidden group/card flex flex-col justify-between`}>
                    <span class={`absolute -right-8 -top-8 size-20 ${item.glowColor} rounded-full blur-xl ${item.innerGlowColor} transition-all duration-300 pointer-events-none`}></span>
                    
                    <div>
                      <!-- Header -->
                      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                        <div class="flex min-w-0 items-center gap-3">
