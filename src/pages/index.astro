---
import MainLayout from "@/layouts/MainLayout.astro";
import SiteHeader from "@/components/sections/SiteHeader.astro";
import Hero from "@/components/sections/Hero.astro";
import GithubActivity from "@/components/sections/GithubActivity.astro";
import Projects from "@/components/sections/Projects.astro";
import Skills from "@/components/sections/Skills.astro";
import Experience from "@/components/sections/Experience.astro";
import Contact from "@/components/sections/Contact.astro";
import SiteFooter from "@/components/sections/SiteFooter.astro";
import EmedicardModal from "@/components/modals/EmedicardModal.astro";
import ReadoramaModal from "@/components/modals/ReadoramaModal.astro";
import ImagePreviewModal from "@/components/modals/ImagePreviewModal.astro";

export const prerender = true;
---

<MainLayout
  title="Sean Paul Lapasanda | Full Stack Software Engineer"
  description="Portfolio of Sean Paul S. Lapasanda, a full-stack engineer building Laravel, React, React Native, and TypeScript systems."
>
  <SiteHeader />

  <main id="top">
    <Hero />
    <GithubActivity />
    <Projects />
    <Skills />
    <Experience />
    <Contact />
  </main>

  <EmedicardModal />
  <ReadoramaModal />
  <ImagePreviewModal />

  <SiteFooter />
</MainLayout>

<!-- Page-level client scripts: modal/lightbox logic and scroll animations -->
<script>
  import "@/scripts/modals";
  import "@/scripts/scrollReveal";
</script>
